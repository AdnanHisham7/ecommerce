<% if (bestSellers && bestSellers.length) { %>
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-8">
  <div class="flex items-end justify-between mb-8">
    <div>
      <span class="inline-flex items-center gap-1.5 text-red-500 font-semibold text-sm mb-2">
        <i class="fa-solid fa-fire text-xs animate-pulse"></i> Trending Now
      </span>
      <h2 class="text-3xl md:text-4xl font-black dark:text-white tracking-tight">
        Best <span class="text-accent-500">Sellers</span>
      </h2>
      <p class="text-gray-500 dark:text-gray-400 mt-1 text-sm">What everyone's buying right now</p>
    </div>
    <a href="/shop?sort=popular" class="hidden md:flex items-center gap-1.5 text-accent-500 hover:text-accent-600 font-semibold text-sm transition-colors group">
      View All <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
    </a>
  </div>
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5">
    <%- include('../product-grid', { products: bestSellers }) %>
  </div>
  <div class="mt-6 text-center md:hidden">
    <a href="/shop?sort=popular" class="inline-flex items-center gap-2 text-accent-500 font-semibold text-sm border border-accent-500/30 px-5 py-2.5 rounded-xl hover:bg-accent-500/5 transition-colors">
      View All Best Sellers <i class="fa-solid fa-arrow-right text-xs"></i>
    </a>
  </div>
</section>
<% } %>
