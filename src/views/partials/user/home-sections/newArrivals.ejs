<% if (newArrivals && newArrivals.length) { %>
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="flex items-end justify-between mb-8">
    <div>
      <span class="inline-flex items-center gap-1.5 text-emerald-500 font-semibold text-sm mb-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping absolute"></span>
        <span class="w-2 h-2 rounded-full bg-emerald-500 relative"></span>
        Just Landed
      </span>
      <h2 class="text-3xl md:text-4xl font-black dark:text-white tracking-tight">
        New <span class="text-accent-500">Arrivals</span>
      </h2>
      <p class="text-gray-500 dark:text-gray-400 mt-1 text-sm">Fresh drops — be the first to gear up</p>
    </div>
    <a href="/shop?filter=new" class="hidden md:flex items-center gap-1.5 text-accent-500 hover:text-accent-600 font-semibold text-sm transition-colors group">
      View All <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
    </a>
  </div>
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5">
    <%- include('../product-grid', { products: newArrivals }) %>
  </div>
  <div class="mt-6 text-center md:hidden">
    <a href="/shop?filter=new" class="inline-flex items-center gap-2 text-accent-500 font-semibold text-sm border border-accent-500/30 px-5 py-2.5 rounded-xl hover:bg-accent-500/5 transition-colors">
      View All New Arrivals <i class="fa-solid fa-arrow-right text-xs"></i>
    </a>
  </div>
</section>
<% } %>
