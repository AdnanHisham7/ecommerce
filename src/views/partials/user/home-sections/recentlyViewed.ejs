<% if (recentlyViewed && recentlyViewed.length) { %>
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="flex items-end justify-between mb-6">
    <div>
      <span class="inline-flex items-center gap-1.5 text-blue-500 font-semibold text-sm mb-2">
        <i class="fa-solid fa-clock-rotate-left text-xs"></i> Your Browsing History
      </span>
      <h2 class="text-2xl md:text-3xl font-black dark:text-white tracking-tight">
        Recently <span class="text-accent-500">Viewed</span>
      </h2>
    </div>
    <a href="/wishlist" class="text-accent-500 hover:text-accent-600 font-semibold text-sm flex items-center gap-1 group">
      My Wishlist <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
    </a>
  </div>
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
    <%- include('../product-grid', { products: recentlyViewed }) %>
  </div>
</section>
<% } %>
