<% if (banners && banners.length) { %>
<section class="usp-bar bg-accent-500 py-3.5 shadow-lg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-center">
      <div class="flex items-center justify-center gap-2 text-primary">
        <i class="fa-solid fa-truck text-lg flex-shrink-0"></i>
        <div class="text-left hidden sm:block">
          <p class="text-xs font-black leading-none">Free Shipping</p>
          <p class="text-xs opacity-75 leading-none mt-0.5">On orders ₹<%= commerceSettings.freeShippingThreshold %>+</p>
        </div>
        <p class="text-xs font-black sm:hidden">Free Shipping ₹<%= commerceSettings.freeShippingThreshold %>+</p>
      </div>
      <div class="flex items-center justify-center gap-2 text-primary">
        <i class="fa-solid fa-rotate-left text-lg flex-shrink-0"></i>
        <div class="text-left hidden sm:block">
          <p class="text-xs font-black leading-none">Easy Returns</p>
          <p class="text-xs opacity-75 leading-none mt-0.5">7-day hassle-free</p>
        </div>
        <p class="text-xs font-black sm:hidden">7-Day Returns</p>
      </div>
      <div class="flex items-center justify-center gap-2 text-primary">
        <i class="fa-solid fa-certificate text-lg flex-shrink-0"></i>
        <div class="text-left hidden sm:block">
          <p class="text-xs font-black leading-none">50+ Top Brands</p>
          <p class="text-xs opacity-75 leading-none mt-0.5">Nike, Adidas & more</p>
        </div>
        <p class="text-xs font-black sm:hidden">50+ Brands</p>
      </div>
      <div class="flex items-center justify-center gap-2 text-primary">
        <i class="fa-solid fa-star text-lg flex-shrink-0"></i>
        <div class="text-left hidden sm:block">
          <p class="text-xs font-black leading-none">4.8★ Rated</p>
          <p class="text-xs opacity-75 leading-none mt-0.5">10,000+ happy fans</p>
        </div>
        <p class="text-xs font-black sm:hidden">4.8★ · 10K+ Fans</p>
      </div>
    </div>
  </div>
</section>
<% } %>
