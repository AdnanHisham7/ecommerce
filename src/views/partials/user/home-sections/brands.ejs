<section class="border-y border-gray-100 dark:border-zinc-800 bg-white dark:bg-zinc-900/30 py-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-center text-xs font-semibold text-gray-400 uppercase tracking-widest mb-8">
      Official gear from the world's top brands
    </p>
    <div class="flex flex-wrap items-center justify-center gap-8 md:gap-14">
      <!-- Brand names as styled text (replace with actual brand logos when available) -->
      <% [
        ['Nike', 'from-blue-600 to-blue-800'],
        ['Adidas', 'from-gray-700 to-gray-900'],
        ['Puma', 'from-red-600 to-red-800'],
        ['New Balance', 'from-green-600 to-green-800'],
        ['Under Armour', 'from-gray-600 to-gray-800'],
        ['Umbro', 'from-accent-500 to-amber-700']
      ].forEach(([brand, gradient]) => { %>
      <a href="/shop?brand=<%= brand.toLowerCase().replace(' ', '-') %>" class="brand-logo-item group flex items-center justify-center opacity-40 hover:opacity-100 transition-all duration-300 hover:scale-105">
        <div class="px-4 py-2 rounded-lg">
          <span class="font-black text-lg text-transparent bg-clip-text bg-gradient-to-r <%= gradient %> dark:from-gray-200 dark:to-gray-400 group-hover:from-amber-500 group-hover:to-amber-700 transition-all whitespace-nowrap">
            <%= brand %>
          </span>
        </div>
      </a>
      <% }) %>
    </div>
  </div>
</section>
