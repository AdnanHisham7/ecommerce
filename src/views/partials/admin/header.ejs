<header class="bg-[#0a0a18] border-b border-white/5 px-4 md:px-6 py-3 md:py-4 flex items-center justify-between flex-shrink-0">
  <div class="flex items-center gap-3">
    <!-- On mobile: show hamburger to toggle sidebar (sidebar collapses to icon mode on desktop via edge button) -->
    <button onclick="document.getElementById('sidebar').classList.toggle('hidden')" class="md:hidden p-2 rounded-lg hover:bg-white/5 text-gray-400" aria-label="Toggle sidebar">
      <i class="fa-solid fa-bars"></i>
    </button>
    <div>
      <h1 class="text-base md:text-lg font-bold text-white"><%= typeof title !== 'undefined' ? title : 'Dashboard' %></h1>
      <p class="text-xs text-gray-500"><%= brand.name %> Admin Panel</p>
    </div>
  </div>
  <div class="flex items-center gap-2 md:gap-3">
    <a href="/" target="_blank" class="flex items-center gap-1.5 px-2.5 md:px-3 py-1.5 bg-white/5 hover:bg-white/10 rounded-lg text-xs text-gray-400 hover:text-gray-200 transition-colors">
      <i class="fa-solid fa-external-link text-xs"></i>
      <span class="hidden sm:inline">View Store</span>
    </a>
    <span class="text-xs text-gray-500 hidden md:block"><%= new Date().toLocaleDateString('en-IN', { weekday: 'short', month: 'short', day: 'numeric' }) %></span>
  </div>
</header>
