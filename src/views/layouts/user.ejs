<!DOCTYPE html>
<html lang="en" class="<%= theme === 'dark' ? 'dark' : '' %>" data-theme="<%= theme || 'system' %>">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= typeof title !== 'undefined' ? title : brand.name %></title>
  <meta name="description" content="<%= typeof seo !== 'undefined' && seo.metaDescription ? seo.metaDescription : brand.description %>"/>

  <link rel="icon" href="<%= brand.logoUrl %>" type="image/svg+xml"/>
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="manifest" href="/pwa/manifest.json"/>

  <!-- Tailwind CDN -->
  <link rel="stylesheet" href="/css/output.css">

  <style>
    :root {
      --color-primary: <%= brand.colors.primary %>;
      --color-accent: <%= brand.colors.accent %>;
      --color-accent-hover: <%= brand.colors.accentHover %>;
    }

    .text-accent-400 { color: <%= brand.colors.accent400 %>; }
    .text-accent-500 { color: var(--color-accent); }
    .text-accent-600 { color: var(--color-accent-hover); }
    .bg-accent-100 { background-color: #fee2e2; }
    .bg-accent-500 { background-color: var(--color-accent); }
    .bg-accent-600 { background-color: var(--color-accent-hover); }
    .border-accent-500 { border-color: var(--color-accent); }
    .hover\:text-accent-500:hover { color: var(--color-accent); }
    .hover\:text-accent-600:hover { color: var(--color-accent-hover); }
    .hover\:bg-accent-500:hover { background-color: var(--color-accent); }
    .focus\:ring-accent-500:focus { --tw-ring-color: var(--color-accent); }
    .ring-accent-500 { --tw-ring-color: var(--color-accent); }
    .accent-50 { background-color: #fef2f2; }

    /* Dark mode fallbacks */
    .dark .dark\:border-gray-800 { border-color: #1f2937; }
    .dark .dark\:border-gray-700 { border-color: #374151; }
    .dark .dark\:bg-gray-900 { background-color: #111827; }

    * { scroll-behavior: smooth; }
    body { font-family: 'Inter', sans-serif; }
    .dark body { background-color: #0f0f1a; }

    /* Bottom nav spacing on mobile */
    @media (max-width: 767px) {
      body { padding-bottom: 64px; }
      .toast-container { bottom: 80px !important; top: auto !important; }
    }

    .skeleton { background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; }
    .dark .skeleton { background: linear-gradient(90deg, #1e1e2e 25%, #2e2e3e 50%, #1e1e2e 75%); background-size: 200% 100%; }

    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: <%= brand.colors.scrollbarThumb %>; border-radius: 3px; }

    .toast-container { position: fixed; top: 1.5rem; right: 1rem; z-index: 9999; display: flex; flex-direction: column; gap: 0.5rem; max-width: calc(100vw - 2rem); }
    .page-transition { animation: slideInUp 0.3s ease-out; }
    .product-card:hover .product-image { transform: scale(1.05); }
    .product-image { transition: transform 0.4s ease; }
    .btn-primary { background: linear-gradient(135deg, var(--color-accent), var(--color-accent-hover)); color: white; transition: all 0.2s; }
    .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 8px 25px rgba(229,62,62,0.4); }
    .nav-link.active { color: var(--color-accent); border-bottom: 2px solid var(--color-accent); }

    @keyframes slideInUp { 0% { transform: translateY(20px); opacity: 0; } 100% { transform: translateY(0); opacity: 1; } }
    @keyframes fadeIn { 0% { opacity: 0; } 100% { opacity: 1; } }
    @keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
    @keyframes float { 0% { transform: translateY(0px); } 50% { transform: translateY(-10px); } 100% { transform: translateY(0px); } }
    .animate-slide-in-up { animation: slideInUp 0.4s ease-out; }
    .animate-float { animation: float 6s ease-in-out infinite; }

    .badge { display: inline-flex; align-items: center; justify-content: center; padding: 0.25rem 0.5rem; font-size: 0.75rem; font-weight: 600; line-height: 1; border-radius: 9999px; white-space: nowrap; text-transform: uppercase; letter-spacing: 0.025em; }

    /* spacing utilities */
    .py-10 { padding-top: 2.5rem; padding-bottom: 2.5rem; }
    .py-14 { padding-top: 3.5rem; padding-bottom: 3.5rem; }
    .px-7 { padding-left: 1.75rem; padding-right: 1.75rem; }
    .gap-5 { gap: 1.25rem; }
    .h-0\.5 { height: 0.125rem; }
    .leading-none { line-height: 1; }
    .transition-none { transition-property: none; }
    .pointer-events-auto { pointer-events: auto; }
    @media (min-width: 768px) { .md\:gap-5 { gap: 1.25rem; } }
    @media (min-width: 1024px) { .lg\:grid-cols-6 { grid-template-columns: repeat(6, minmax(0, 1fr)); } }

    /* List view */
    .list-view .product-card { display: flex; flex-direction: row; height: auto; max-height: 180px; gap: 1.25rem; }
    .list-view .product-card .pc-image-wrap { width: 180px; min-width: 180px; aspect-ratio: unset; height: 180px; flex-shrink: 0; }
    .list-view .product-card .pc-info { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 1rem 1.25rem; }
    .list-view .pc-quick-overlay { display: none !important; }
    .list-view .pc-list-btn { display: flex !important; }
    .pc-desc { display: none; }
    .list-view .pc-desc { display: block !important; margin-bottom: 0.75rem; line-height: 1.4; }
    .list-view .truncate-for-list { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .bottom-18 {
      bottom: 4.5rem; /* or 40px */
    }

    .custom-z{
      z-index: 99999 !important;
    }

    /* ── Mobile Bottom Navigation ─────────────────────────── */
    #mobileBottomNav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background: white;
      border-top: 1px solid #e5e7eb;
      display: flex;
      height: 64px;
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    .dark #mobileBottomNav {
      background: #0f0f1a;
      border-top-color: #1f2937;
    }
    #mobileBottomNav a, #mobileBottomNav button {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      font-size: 10px;
      font-weight: 600;
      color: #9ca3af;
      text-decoration: none;
      transition: color 0.15s;
      position: relative;
      padding: 8px 4px;
    }
    #mobileBottomNav a.active, #mobileBottomNav a:hover, #mobileBottomNav button:hover {
      color: var(--color-accent);
    }
    #mobileBottomNav i { font-size: 18px; }
    @media (min-width: 768px) { #mobileBottomNav { display: none; } }
  </style>

  <!-- Font -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <!-- Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>

  <style>
    /* list-view extras already above */
  </style>

  <%- typeof extraHead !== 'undefined' ? extraHead : '' %>
</head>
<body class="bg-gray-50 dark:bg-[#0f0f1a] text-gray-900 dark:text-gray-100 transition-colors duration-300">

<!-- Toast Notifications -->
<div class="toast-container" id="toastContainer">
  <% if (success && success.length) { success.forEach(msg => { %>
    <div class="toast flex items-center gap-3 bg-green-600 text-white px-4 py-3 rounded-xl shadow-xl animate-slide-in-up max-w-sm">
      <i class="fa-solid fa-circle-check flex-shrink-0"></i><span class="text-sm"><%= msg %></span>
      <button onclick="this.parentElement.remove()" class="ml-auto opacity-70 hover:opacity-100"><i class="fa-solid fa-xmark"></i></button>
    </div>
  <% }) } %>
  <% if (error && error.length) { error.forEach(msg => { %>
    <div class="toast flex items-center gap-3 bg-red-600 text-white px-4 py-3 rounded-xl shadow-xl animate-slide-in-up max-w-sm">
      <i class="fa-solid fa-circle-exclamation flex-shrink-0"></i><span class="text-sm"><%= msg %></span>
      <button onclick="this.parentElement.remove()" class="ml-auto opacity-70 hover:opacity-100"><i class="fa-solid fa-xmark"></i></button>
    </div>
  <% }) } %>
  <% if (info && info.length) { info.forEach(msg => { %>
    <div class="toast flex items-center gap-3 bg-blue-600 text-white px-4 py-3 rounded-xl shadow-xl animate-slide-in-up max-w-sm">
      <i class="fa-solid fa-circle-info flex-shrink-0"></i><span class="text-sm"><%= msg %></span>
      <button onclick="this.parentElement.remove()" class="ml-auto opacity-70 hover:opacity-100"><i class="fa-solid fa-xmark"></i></button>
    </div>
  <% }) } %>
</div>

<!-- Header -->
<%- include('../partials/user/header') %>

<!-- Main Content -->
<main class="page-transition min-h-screen <%= typeof currentPath !== 'undefined' && currentPath === '/' ? '' : 'py-2' %>">
  <%- body %>
</main>

<!-- Footer -->
<%- include('../partials/user/footer') %>

<!-- ── Mobile Bottom Navigation ────────────────────────────────────────── -->
<nav id="mobileBottomNav" aria-label="Mobile navigation">
  <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">
    <i class="fa-solid fa-house"></i>
    <span>Home</span>
  </a>
  <a href="/shop" class="<%= currentPath.startsWith('/shop') ? 'active' : '' %>">
    <i class="fa-solid fa-store"></i>
    <span>Shop</span>
  </a>
  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
  <a href="/cart" class="<%= currentPath === '/cart' ? 'active' : '' %>" style="position:relative;">
    <i class="fa-solid fa-bag-shopping"></i>
    <% if (cartCount > 0) { %>
      <span style="position:absolute;top:6px;right:calc(50% - 14px);background:var(--color-accent);color:white;font-size:9px;width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;" id="mobileCartCount"><%= cartCount %></span>
    <% } %>
    <span>Cart</span>
  </a>
  <a href="/wishlist" class="<%= currentPath === '/wishlist' ? 'active' : '' %>">
    <i class="fa-regular fa-heart"></i>
    <span>Wishlist</span>
  </a>
  <a href="/dashboard" class="<%= currentPath.startsWith('/dashboard') || currentPath.startsWith('/profile') || currentPath.startsWith('/orders') ? 'active' : '' %>">
    <% if (currentUser.avatar) { %>
      <img src="<%= currentUser.avatar %>" alt="" style="width:22px;height:22px;border-radius:50%;object-fit:cover;border:2px solid var(--color-accent);"/>
    <% } else { %>
      <i class="fa-solid fa-user"></i>
    <% } %>
    <span>Account</span>
  </a>
  <% } else { %>
  <a href="/cart" class="<%= currentPath === '/cart' ? 'active' : '' %>" style="position:relative;">
    <i class="fa-solid fa-bag-shopping"></i>
    <% if (cartCount > 0) { %>
      <span style="position:absolute;top:6px;right:calc(50% - 14px);background:var(--color-accent);color:white;font-size:9px;width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;" id="mobileCartCount"><%= cartCount %></span>
    <% } %>
    <span>Cart</span>
  </a>
  <a href="/auth/login" class="<%= currentPath.startsWith('/auth') ? 'active' : '' %>">
    <i class="fa-solid fa-right-to-bracket"></i>
    <span>Login</span>
  </a>
  <% } %>
</nav>

<!-- Global JS -->
<script>
document.querySelectorAll('.toast').forEach(t => setTimeout(() => t.style.display='none', 5000));

const initTheme = () => {
  const saved = localStorage.getItem('theme') || '<%= theme %>';
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  if (saved === 'dark' || (saved === 'system' && prefersDark)) {
    document.documentElement.classList.add('dark');
  } else {
    document.documentElement.classList.remove('dark');
  }
};
initTheme();

window.addToCart = async (productId, colorId, sizeId, qty = 1) => {
  try {
    const r = await fetch('/cart/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productId, colorId: colorId || null, sizeId: sizeId || null, quantity: qty }),
    });

    const data = await r.json();
    if (data.success) {
      showToast(data.message, 'success');
      const cc = document.getElementById('cartCount');
      if (cc) cc.textContent = data.cartCount;
      const mcc = document.getElementById('mobileCartCount');
      if (mcc) mcc.textContent = data.cartCount;
    } else {
      showToast(data.message || 'Error', 'error');
    }
  } catch { showToast('Error adding to cart', 'error'); }
};

window.toggleTheme = () => {
  const isDark = document.documentElement.classList.toggle('dark');
  const theme = isDark ? 'dark' : 'light';
  localStorage.setItem('theme', theme);
  fetch('/theme', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ theme }) });
  document.getElementById('themeIcon')?.classList.toggle('fa-moon', !isDark);
  document.getElementById('themeIcon')?.classList.toggle('fa-sun', isDark);
};
document.getElementById('themeToggleBtn')?.addEventListener('click', window.toggleTheme);

window.toggleWishlist = async (productId, btn) => {
  if (!productId) return;
  try {
    const r = await fetch('/wishlist/toggle', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ productId }) });
    const data = await r.json();
    if (r.status === 302 || r.redirected) { window.location.href = '/auth/login'; return; }
    if (data.success) {
      btn.classList.toggle('text-red-500', data.action === 'added');
      btn.classList.toggle('text-gray-400', data.action !== 'added');
      showToast(data.message, data.action === 'added' ? 'success' : 'info');
      const countEl = document.getElementById('wishlistCount');
      if (countEl) { let c = parseInt(countEl.textContent) || 0; countEl.textContent = data.action === 'added' ? c+1 : Math.max(0,c-1); }
    }
  } catch { showToast('Please login first', 'error'); }
};

window.showToast = (msg, type='success') => {
  const colors = { success:'bg-green-600', error:'bg-red-600', info:'bg-blue-600', warning:'bg-yellow-600' };
  const icons = { success:'fa-circle-check', error:'fa-circle-exclamation', info:'fa-circle-info', warning:'fa-triangle-exclamation' };
  const el = document.createElement('div');
  el.className = `toast flex items-center gap-3 ${colors[type]||colors.info} text-white px-4 py-3 rounded-xl shadow-xl animate-slide-in-up max-w-sm`;
  el.innerHTML = `<i class="fa-solid ${icons[type]||icons.info} flex-shrink-0"></i><span class="text-sm">${msg}</span><button onclick="this.parentElement.remove()" class="ml-auto opacity-70 hover:opacity-100"><i class="fa-solid fa-xmark"></i></button>`;
  document.getElementById('toastContainer').appendChild(el);
  setTimeout(() => el.remove(), 5000);
};

<% if (typeof currentUser !== 'undefined' && currentUser) { %>
if (window.io) {
  const socket = io();
  socket.emit('join_user', '<%= currentUser._id %>');
  socket.on('notification', (data) => { showToast(data.message, 'info'); });
  socket.on('new_offer', (data) => { showToast(`🔥 New Offer: ${data.offerName} — ${data.discountText}`, 'info'); });
  socket.on('new_coupon', (data) => { showToast(`🎟️ New Coupon: ${data.code}`, 'info'); });
}
<% } %>
</script>

<% if (typeof currentUser !== 'undefined' && currentUser) { %>
<script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
<script>
  window.OneSignalDeferred = window.OneSignalDeferred || [];
  OneSignalDeferred.push(async function(OneSignal) {
    await OneSignal.init({
      appId: "<%= typeof oneSignalAppId !== 'undefined' ? oneSignalAppId : '' %>",
      notifyButton: { enable: false },
      allowLocalhostAsSecureOrigin: true,
      serviceWorkerParam: { scope: "/" },
      serviceWorkerPath: "OneSignalSDKWorker.js",
    });
    if (OneSignal.Notifications.permissionNative === 'default') {
      await OneSignal.Notifications.requestPermission();
    }
    const userId = '<%= currentUser._id %>';
    if (userId && OneSignal.Notifications.permission) {
      await OneSignal.login(userId.toString());
    }
  });
</script>
<% } %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.7.5/socket.io.min.js"></script>
<script>
  window.__FEATURE_FLAGS__ = {
    pushNotifications: <%= featureFlags && featureFlags.pushNotifications ? 'true' : 'false' %>,
    referralProgram:   <%= featureFlags && featureFlags.referralProgram   ? 'true' : 'false' %>,
    reviewSystem:      <%= featureFlags && featureFlags.reviewSystem      ? 'true' : 'false' %>,
  };
</script>
<script src="/js/shared/main.js"></script>
<%- typeof extraScripts !== 'undefined' ? extraScripts : '' %>
</body>
</html>
