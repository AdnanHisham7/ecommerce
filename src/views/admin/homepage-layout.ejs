<% layout('layouts/admin') %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-xl font-bold text-white">Homepage Layout</h2>
    <p class="text-gray-500 text-sm">Reorder the sections shown on the storefront homepage. Navbar and Footer are always fixed and are not listed here.</p>
  </div>
</div>

<div class="card p-4 md:p-6 max-w-2xl">
  <ol id="sectionList" class="space-y-2">
    <% order.forEach(function (key, idx) { %>
    <li class="flex items-center gap-3 bg-white/5 border border-white/10 rounded-xl px-4 py-3" data-key="<%= key %>">
      <span class="w-7 h-7 flex items-center justify-center rounded-lg bg-accent-500/20 text-accent-400 font-bold text-xs flex-shrink-0 section-index"><%= idx + 1 %></span>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-semibold text-white"><%= sectionMeta[key]?.label || key %></p>
        <p class="text-xs text-gray-500 truncate"><%= sectionMeta[key]?.desc || '' %></p>
      </div>
      <div class="flex items-center gap-1 flex-shrink-0">
        <button type="button" class="move-up p-2 rounded-lg text-gray-400 hover:text-white hover:bg-white/10 disabled:opacity-30 disabled:cursor-not-allowed" title="Move up">
          <i class="fa-solid fa-chevron-up text-xs"></i>
        </button>
        <button type="button" class="move-down p-2 rounded-lg text-gray-400 hover:text-white hover:bg-white/10 disabled:opacity-30 disabled:cursor-not-allowed" title="Move down">
          <i class="fa-solid fa-chevron-down text-xs"></i>
        </button>
      </div>
    </li>
    <% }) %>
  </ol>

  <div class="flex items-center justify-between mt-6 pt-4 border-t border-white/5">
    <p id="layoutSaveStatus" class="text-xs text-gray-500"></p>
    <button id="saveLayoutBtn" class="bg-accent-500 text-primary px-5 py-2.5 rounded-xl text-sm font-bold">
      Save Layout
    </button>
  </div>
</div>

<script>
  const list = document.getElementById('sectionList');
  const saveBtn = document.getElementById('saveLayoutBtn');
  const statusEl = document.getElementById('layoutSaveStatus');

  function renumber() {
    const items = Array.from(list.children);
    items.forEach((li, i) => {
      li.querySelector('.section-index').textContent = i + 1;
      li.querySelector('.move-up').disabled = i === 0;
      li.querySelector('.move-down').disabled = i === items.length - 1;
    });
  }

  list.addEventListener('click', (e) => {
    const upBtn = e.target.closest('.move-up');
    const downBtn = e.target.closest('.move-down');
    if (!upBtn && !downBtn) return;

    const li = e.target.closest('li');
    if (upBtn && li.previousElementSibling) {
      list.insertBefore(li, li.previousElementSibling);
    } else if (downBtn && li.nextElementSibling) {
      list.insertBefore(li.nextElementSibling, li);
    }
    renumber();
    statusEl.textContent = 'Unsaved changes';
  });

  saveBtn.addEventListener('click', async () => {
    const order = Array.from(list.children).map((li) => li.dataset.key);
    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';
    try {
      const res = await fetch('/admin/homepage-layout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ order }),
      });
      const data = await res.json();
      if (data.success) {
        showToast('Homepage layout saved', 'success');
        statusEl.textContent = 'Saved';
      } else {
        showToast(data.message || 'Failed to save layout', 'error');
      }
    } catch (err) {
      showToast('Failed to save layout', 'error');
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Layout';
    }
  });

  renumber();
</script>
