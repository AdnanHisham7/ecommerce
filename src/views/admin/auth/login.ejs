<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Login — FootballStore</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet"/>
  <link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <style>body { font-family: 'Inter', sans-serif; background: #080812; }</style>

</head>
<body class="min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md">
    <!-- Logo -->
    <div class="text-center mb-8">
      <div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4 shadow-2xl overflow-hidden">
        <img
          src="/images/logo.svg"
          alt="AD21Store Logo"
          class="w-full h-full object-contain"
        />
      </div>
      <h1 class="text-3xl font-black text-white">AD21Store</h1>
      <p class="text-gray-500 text-sm mt-1">Admin Control Panel</p>
    </div>

    <div class="bg-[#0f0f1a] border border-white/10 rounded-3xl p-8 shadow-2xl">
      <h2 class="text-xl font-bold text-white mb-6 text-center">Sign In to Admin</h2>

      <% if (typeof error !== 'undefined' && error && error.length) { %>
      <div class="bg-red-900/30 border border-red-800 text-red-400 rounded-xl p-3 mb-5 text-sm flex items-center gap-2">
        <i class="fa-solid fa-circle-exclamation"></i> <%= error[0] %>
      </div>
      <% } %>

      <form action="/admin/login" method="POST" class="space-y-5">
        <div>
          <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2 block">Email Address</label>
          <div class="relative">
            <i class="fa-solid fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-sm"></i>
            <input type="email" name="email" required placeholder="admin@footballstore.com"
              class="w-full bg-[#1a1a2e] border border-white/10 text-white placeholder-gray-600 rounded-xl pl-11 pr-4 py-3 text-sm focus:border-yellow-500 focus:ring-2 focus:ring-yellow-500/20 outline-none transition-all"/>
          </div>
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2 block">Password</label>
          <div class="relative">
            <i class="fa-solid fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-sm"></i>
            <input type="password" name="password" id="adminPwd" required placeholder="••••••••"
              class="w-full bg-[#1a1a2e] border border-white/10 text-white placeholder-gray-600 rounded-xl pl-11 pr-12 py-3 text-sm focus:border-yellow-500 focus:ring-2 focus:ring-yellow-500/20 outline-none transition-all"/>
            <button type="button" onclick="const i=document.getElementById('adminPwd'); i.type=i.type==='text'?'password':'text'" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-300 transition-colors">
              <i class="fa-regular fa-eye text-sm"></i>
            </button>
          </div>
        </div>
        <button type="submit" class="w-full bg-gradient-to-r from-yellow-500 to-yellow-600 text-[#1a1a2e] py-3.5 rounded-xl font-black text-base hover:from-yellow-400 hover:to-yellow-500 transition-all shadow-lg hover:shadow-yellow-500/30 flex items-center justify-center gap-2">
          <i class="fa-solid fa-shield-halved"></i> Sign In to Admin
        </button>
      </form>

      <div class="text-center mt-5">
        <a href="/" class="text-gray-500 hover:text-gray-300 text-sm transition-colors flex items-center justify-center gap-1">
          <i class="fa-solid fa-arrow-left text-xs"></i> Back to Store
        </a>
      </div>
    </div>

    <p class="text-center text-xs text-gray-600 mt-6">Protected area — Unauthorized access is prohibited</p>
  </div>
</body>
</html>
