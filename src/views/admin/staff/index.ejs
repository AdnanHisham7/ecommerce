<% layout('layouts/admin') %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-xl font-bold text-white">Staff Accounts</h2>
    <p class="text-sm text-gray-500 mt-0.5">Manage staff access and permissions</p>
  </div>
  <button onclick="openAddModal()"
    class="flex items-center gap-2 bg-gradient-to-r from-accent-500 to-accent-600 text-primary px-4 py-2.5 rounded-xl font-bold text-sm hover:opacity-90 transition-opacity">
    <i class="fa-solid fa-user-plus"></i> Add Staff
  </button>
</div>

<!-- Staff Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-6" id="staffGrid">
  <% if (staff.length) { staff.forEach(member => { %>
  <div class="card p-5 flex flex-col gap-3" id="staff-card-<%= member._id %>">
    <!-- Header -->
    <div class="flex items-center gap-3">
      <div class="w-12 h-12 rounded-full bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center text-white font-black text-lg flex-shrink-0">
        <%= member.name.charAt(0).toUpperCase() %>
      </div>
      <div class="min-w-0 flex-1">
        <p class="font-bold text-gray-200 truncate"><%= member.name %></p>
        <p class="text-xs text-gray-500 truncate"><%= member.email %></p>
        <span class="badge bg-blue-500/20 text-blue-400 text-xs mt-0.5">Staff</span>
      </div>
    </div>

    <!-- Permissions badges -->
    <div>
      <p class="text-xs text-gray-500 mb-1.5">Permissions:</p>
      <div class="flex flex-wrap gap-1.5" id="perms-<%= member._id %>">
        <% (member.permissions || []).forEach(perm => { %>
        <span class="text-xs bg-white/5 text-gray-400 px-2 py-0.5 rounded-full capitalize"><%= perm.replace(/_/g,' ') %></span>
        <% }) %>
        <% if (!(member.permissions?.length)) { %>
        <span class="text-xs text-gray-600 italic">No permissions assigned</span>
        <% } %>
      </div>
    </div>

    <!-- Action buttons -->
    <div class="flex gap-2 mt-auto pt-1">
      <button onclick="openEditInfoModal('<%= member._id %>', '<%= member.name %>', '<%= member.email %>')"
        class="flex-1 text-xs border border-white/10 rounded-lg py-2 text-gray-400 hover:border-blue-500 hover:text-blue-400 transition-all flex items-center justify-center gap-1.5">
        <i class="fa-solid fa-pen-to-square"></i> Edit Info
      </button>
      <button onclick="openEditPermModal('<%= member._id %>', '<%= member.name %>', <%= JSON.stringify(member.permissions || []) %>)"
        class="flex-1 text-xs border border-white/10 rounded-lg py-2 text-gray-400 hover:border-accent-500 hover:text-accent-400 transition-all flex items-center justify-center gap-1.5">
        <i class="fa-solid fa-shield-halved"></i> Permissions
      </button>
      <button onclick="deleteStaff('<%= member._id %>', '<%= member.name %>')"
        class="text-xs border border-white/10 rounded-lg py-2 px-3 text-gray-600 hover:border-red-500 hover:text-red-400 transition-all">
        <i class="fa-solid fa-trash"></i>
      </button>
    </div>
  </div>
  <% }) } else { %>
  <div class="col-span-full text-center py-16 text-gray-500">
    <i class="fa-solid fa-user-shield text-4xl mb-3 block text-gray-700"></i>
    <p class="font-medium">No staff accounts yet</p>
    <p class="text-xs mt-1">Click "Add Staff" to create one</p>
  </div>
  <% } %>
</div>


<!-- ─── Add Staff Modal ──────────────────────────────────────────── -->
<div id="addStaffModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 transparent-black backdrop-blur-sm" onclick="closeModal('addStaffModal')"></div>
  <div class="relative bg-[#1a1a2e] border border-white/10 rounded-2xl p-6 w-full max-w-md shadow-2xl">
    <h3 class="font-bold text-white mb-5 flex items-center gap-2">
      <i class="fa-solid fa-user-plus text-accent-400"></i> Add Staff Account
    </h3>
    <form id="addStaffForm" class="space-y-3">
      <input type="text" name="name" required placeholder="Full Name"
        class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-accent-500"/>
      <input type="email" name="email" required placeholder="Email Address"
        class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-accent-500"/>
      <input type="password" name="password" required minlength="8" placeholder="Password (min 8 chars)"
        class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-accent-500"/>
      <div>
        <p class="text-xs text-gray-400 mb-2 font-medium">Assign Permissions:</p>
        <div class="grid grid-cols-2 gap-2">
          <% ['manage_products','manage_orders','manage_users','manage_coupons','manage_offers','manage_banners','view_analytics','manage_categories','manage_staff','manage_settings'].forEach(perm => { %>
          <label class="flex items-center gap-2 text-xs text-gray-300 cursor-pointer hover:text-white transition-colors p-1.5 rounded-lg hover:bg-white/5">
            <input type="checkbox" name="permissions" value="<%= perm %>" class="accent-yellow-500 w-3.5 h-3.5"/>
            <span class="capitalize"><%= perm.replace(/_/g,' ') %></span>
          </label>
          <% }) %>
        </div>
      </div>
      <div id="addStaffError" class="hidden text-xs text-red-400 bg-red-900/20 border border-red-800/40 rounded-lg px-3 py-2"></div>
      <div class="flex gap-3 pt-2">
        <button type="submit" id="addStaffBtn"
          class="flex-1 bg-gradient-to-r from-accent-500 to-accent-600 text-primary py-2.5 rounded-xl font-bold text-sm hover:opacity-90 transition-opacity">
          Create Staff
        </button>
        <button type="button" onclick="closeModal('addStaffModal')"
          class="px-4 py-2.5 border border-white/10 rounded-xl text-gray-400 text-sm hover:border-white/30 transition-colors">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>


<!-- ─── Edit Info Modal ──────────────────────────────────────────── -->
<div id="editInfoModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 transparent-black backdrop-blur-sm" onclick="closeModal('editInfoModal')"></div>
  <div class="relative bg-[#1a1a2e] border border-white/10 rounded-2xl p-6 w-full max-w-md shadow-2xl">
    <h3 id="editInfoTitle" class="font-bold text-white mb-5 flex items-center gap-2">
      <i class="fa-solid fa-pen-to-square text-blue-400"></i> Edit Staff Info
    </h3>
    <form id="editInfoForm" class="space-y-3">
      <input type="hidden" id="editInfoId"/>
      <input type="text" name="name" id="editInfoName" required placeholder="Full Name"
        class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500"/>
      <input type="email" name="email" id="editInfoEmail" required placeholder="Email Address"
        class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500"/>
      <div class="relative">
        <input type="password" name="password" id="editInfoPassword" minlength="8"
          placeholder="New Password (leave blank to keep current)"
          class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500"/>
        <p class="text-xs text-gray-600 mt-1 px-1">Min 8 characters. Leave blank to keep existing password.</p>
      </div>
      <div id="editInfoError" class="hidden text-xs text-red-400 bg-red-900/20 border border-red-800/40 rounded-lg px-3 py-2"></div>
      <div class="flex gap-3 pt-2">
        <button type="submit" id="editInfoBtn"
          class="flex-1 bg-gradient-to-r from-blue-600 to-blue-700 text-white py-2.5 rounded-xl font-bold text-sm hover:opacity-90 transition-opacity">
          Save Changes
        </button>
        <button type="button" onclick="closeModal('editInfoModal')"
          class="px-4 py-2.5 border border-white/10 rounded-xl text-gray-400 text-sm hover:border-white/30 transition-colors">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>


<!-- ─── Edit Permissions Modal ───────────────────────────────────── -->
<div id="editPermModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 transparent-black backdrop-blur-sm" onclick="closeModal('editPermModal')"></div>
  <div class="relative bg-[#1a1a2e] border border-white/10 rounded-2xl p-6 w-full max-w-md shadow-2xl">
    <h3 id="editPermTitle" class="font-bold text-white mb-5 flex items-center gap-2">
      <i class="fa-solid fa-shield-halved text-accent-400"></i> Edit Permissions
    </h3>
    <form id="editPermForm" class="space-y-3">
      <input type="hidden" id="editPermId"/>
      <div class="grid grid-cols-2 gap-2">
        <% ['manage_products','manage_orders','manage_users','manage_coupons','manage_offers','manage_banners','view_analytics','manage_categories','manage_staff','manage_settings'].forEach(perm => { %>
        <label class="flex items-center gap-2 text-xs text-gray-300 cursor-pointer hover:text-white transition-colors p-1.5 rounded-lg hover:bg-white/5">
          <input type="checkbox" name="permissions" value="<%= perm %>" class="perm-check accent-yellow-500 w-3.5 h-3.5" data-perm="<%= perm %>"/>
          <span class="capitalize"><%= perm.replace(/_/g,' ') %></span>
        </label>
        <% }) %>
      </div>
      <div id="editPermError" class="hidden text-xs text-red-400 bg-red-900/20 border border-red-800/40 rounded-lg px-3 py-2"></div>
      <div class="flex gap-3 pt-2">
        <button type="submit" id="editPermBtn"
          class="flex-1 bg-gradient-to-r from-accent-500 to-accent-600 text-primary py-2.5 rounded-xl font-bold text-sm hover:opacity-90 transition-opacity">
          Save Permissions
        </button>
        <button type="button" onclick="closeModal('editPermModal')"
          class="px-4 py-2.5 border border-white/10 rounded-xl text-gray-400 text-sm hover:border-white/30 transition-colors">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>


<script>
const ALL_PERMS = ['manage_products','manage_orders','manage_users','manage_coupons',
  'manage_offers','manage_banners','view_analytics','manage_categories','manage_staff','manage_settings'];

// ── Helpers ──────────────────────────────────────────────────────────────────
function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
function openModal(id)  { document.getElementById(id).classList.remove('hidden'); }

function showError(elId, msg) {
  const el = document.getElementById(elId);
  el.textContent = msg;
  el.classList.remove('hidden');
}
function clearError(elId) { document.getElementById(elId).classList.add('hidden'); }

function setLoading(btnId, loading, text = 'Save') {
  const btn = document.getElementById(btnId);
  btn.disabled = loading;
  btn.innerHTML = loading
    ? '<i class="fa-solid fa-spinner fa-spin mr-1"></i> Saving…'
    : text;
}

async function apiPost(url, body) {
  const res = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  return res.json();
}

function permBadge(perm) {
  return `<span class="text-xs bg-white/5 text-gray-400 px-2 py-0.5 rounded-full capitalize">${perm.replace(/_/g,' ')}</span>`;
}

// ── Add Staff ─────────────────────────────────────────────────────────────────
function openAddModal() {
  document.getElementById('addStaffForm').reset();
  clearError('addStaffError');
  openModal('addStaffModal');
}

document.getElementById('addStaffForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  clearError('addStaffError');
  const fd = new FormData(e.target);
  const perms = [...document.querySelectorAll('#addStaffForm input[name="permissions"]:checked')].map(c => c.value);
  setLoading('addStaffBtn', true, 'Create Staff');

  const data = await apiPost('/admin/staff/add', {
    name: fd.get('name'),
    email: fd.get('email'),
    password: fd.get('password'),
    permissions: perms,
  });

  setLoading('addStaffBtn', false, 'Create Staff');
  if (data.success) {
    location.reload();
  } else {
    showError('addStaffError', data.message || 'Failed to create staff');
  }
});

// ── Edit Info ─────────────────────────────────────────────────────────────────
function openEditInfoModal(id, name, email) {
  document.getElementById('editInfoId').value = id;
  document.getElementById('editInfoName').value = name;
  document.getElementById('editInfoEmail').value = email;
  document.getElementById('editInfoPassword').value = '';
  document.getElementById('editInfoTitle').innerHTML =
    `<i class="fa-solid fa-pen-to-square text-blue-400"></i> Edit — ${name}`;
  clearError('editInfoError');
  openModal('editInfoModal');
}

document.getElementById('editInfoForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  clearError('editInfoError');
  const id = document.getElementById('editInfoId').value;
  const name = document.getElementById('editInfoName').value.trim();
  const email = document.getElementById('editInfoEmail').value.trim();
  const password = document.getElementById('editInfoPassword').value;

  if (password && password.length < 8) {
    showError('editInfoError', 'Password must be at least 8 characters');
    return;
  }

  setLoading('editInfoBtn', true, 'Save Changes');
  const body = { name, email };
  if (password) body.password = password;

  const data = await apiPost(`/admin/staff/${id}/info`, body);
  setLoading('editInfoBtn', false, 'Save Changes');

  if (data.success) {
    closeModal('editInfoModal');
    // Update card UI inline
    const card = document.getElementById(`staff-card-${id}`);
    if (card) {
      card.querySelector('p.font-bold').textContent = name;
      card.querySelector('p.text-xs.text-gray-500').textContent = email;
    }
    showToast('Staff info updated', 'success');
  } else {
    showError('editInfoError', data.message || 'Update failed');
  }
});

// ── Edit Permissions ──────────────────────────────────────────────────────────
function openEditPermModal(id, name, perms) {
  document.getElementById('editPermId').value = id;
  document.getElementById('editPermTitle').innerHTML =
    `<i class="fa-solid fa-shield-halved text-accent-400"></i> Permissions — ${name}`;
  document.querySelectorAll('.perm-check').forEach(cb => {
    cb.checked = perms.includes(cb.dataset.perm);
  });
  clearError('editPermError');
  openModal('editPermModal');
}

document.getElementById('editPermForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  clearError('editPermError');
  const id = document.getElementById('editPermId').value;
  const perms = [...document.querySelectorAll('.perm-check:checked')].map(c => c.value);

  setLoading('editPermBtn', true, 'Save Permissions');
  const data = await apiPost(`/admin/staff/${id}/permissions`, { permissions: perms });
  setLoading('editPermBtn', false, 'Save Permissions');

  if (data.success) {
    closeModal('editPermModal');
    // Update badges inline
    const badge_container = document.getElementById(`perms-${id}`);
    if (badge_container) {
      badge_container.innerHTML = perms.length
        ? perms.map(permBadge).join('')
        : '<span class="text-xs text-gray-600 italic">No permissions assigned</span>';
    }
    showToast('Permissions updated', 'success');
  } else {
    showError('editPermError', data.message || 'Failed to update permissions');
  }
});

// ── Delete Staff ──────────────────────────────────────────────────────────────
async function deleteStaff(id, name) {
  if (!confirm(`Delete staff account for "${name}"? This cannot be undone.`)) return;

  const data = await apiPost(`/admin/staff/${id}/delete`, {});
  if (data.success) {
    const card = document.getElementById(`staff-card-${id}`);
    if (card) card.remove();
    showToast(`${name}'s account deleted`, 'success');
    // Show empty state if no cards left
    if (!document.querySelectorAll('[id^="staff-card-"]').length) {
      document.getElementById('staffGrid').innerHTML =
        `<div class="col-span-full text-center py-16 text-gray-500">
          <i class="fa-solid fa-user-shield text-4xl mb-3 block text-gray-700"></i>
          <p class="font-medium">No staff accounts yet</p>
          <p class="text-xs mt-1">Click "Add Staff" to create one</p>
        </div>`;
    }
  } else {
    showToast(data.message || 'Delete failed', 'error');
  }
}

// ── Toast ─────────────────────────────────────────────────────────────────────
function showToast(message, type = 'success') {
  const colors = { success: 'bg-green-900/80 border-green-700 text-green-300', error: 'bg-red-900/80 border-red-700 text-red-300' };
  const icons  = { success: 'fa-check-circle', error: 'fa-circle-xmark' };
  const toast = document.createElement('div');
  toast.className = `fixed bottom-6 right-6 z-[999] flex items-center gap-3 px-4 py-3 rounded-xl border shadow-xl text-sm font-medium transition-all ${colors[type]}`;
  toast.innerHTML = `<i class="fa-solid ${icons[type]}"></i> ${message}`;
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 3500);
}
</script>
