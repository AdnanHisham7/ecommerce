<!-- Add SKU Modal -->
<div id="addSkuModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 transparent-black" onclick="closeModal('addSkuModal')"></div>
  <div class="relative bg-[#1a1a2e] border border-white/10 rounded-2xl p-6 w-full max-w-md shadow-2xl">
    <h3 class="font-bold text-white mb-1">Add SKU Variant</h3>
    <p class="text-xs text-gray-500 mb-4" id="addSkuSubtitle"></p>
    <div class="space-y-3">
      <div id="addSkuColorField" class="hidden">
        <label class="text-xs text-gray-400 block mb-1">Color *</label>
        <select id="skuColorId" class="w-full rounded-lg px-3 py-2 text-sm">
          <option value="">Select color</option>
          <% product.colorVariants?.filter(c=>c.isActive).forEach(cv => { %>
          <option value="<%= cv._id %>"><%= cv.color %></option>
          <% }) %>
        </select>
      </div>
      <div id="addSkuSizeField" class="hidden">
        <label class="text-xs text-gray-400 block mb-1">Size *</label>
        <select id="skuSizeId" class="w-full rounded-lg px-3 py-2 text-sm">
          <option value="">Select size</option>
          <% product.sizeVariants?.filter(s=>s.isActive).forEach(sv => { %>
          <option value="<%= sv._id %>"><%= sv.size %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="text-xs text-gray-400 block mb-1">SKU Code</label>
        <input type="text" id="skuCode" placeholder="e.g. PROD-RED-M" class="w-full rounded-lg px-3 py-2 text-sm"/>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="text-xs text-gray-400 block mb-1">Price (₹) *</label>
          <input type="number" id="skuPrice" min="0" step="0.01" placeholder="999" class="w-full rounded-lg px-3 py-2 text-sm"/>
        </div>
        <div>
          <label class="text-xs text-gray-400 block mb-1">Compare At Price</label>
          <input type="number" id="skuComparePrice" min="0" step="0.01" placeholder="1499" class="w-full rounded-lg px-3 py-2 text-sm"/>
        </div>
      </div>
      <div>
        <label class="text-xs text-gray-400 block mb-1">Stock *</label>
        <input type="number" id="skuStock" min="0" value="0" class="w-full rounded-lg px-3 py-2 text-sm"/>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="saveSkuVariant()" class="flex-1 bg-accent-500 text-primary py-2.5 rounded-xl font-bold text-sm">Save SKU</button>
        <button type="button" onclick="closeModal('addSkuModal')" class="px-4 py-2.5 border border-white/10 rounded-xl text-gray-400 text-sm">Cancel</button>
      </div>
    </div>
  </div>
</div>

<!-- Edit SKU Modal -->
<div id="editSkuModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 transparent-black" onclick="closeModal('editSkuModal')"></div>
  <div class="relative bg-[#1a1a2e] border border-white/10 rounded-2xl p-6 w-full max-w-md shadow-2xl">
    <h3 class="font-bold text-white mb-4">Edit SKU Variant</h3>
    <input type="hidden" id="editSkuId"/>
    <div class="space-y-3">
      <div>
        <label class="text-xs text-gray-400 block mb-1">SKU Code</label>
        <input type="text" id="editSkuCode" class="w-full rounded-lg px-3 py-2 text-sm"/>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="text-xs text-gray-400 block mb-1">Price (₹) *</label>
          <input type="number" id="editSkuPrice" min="0" step="0.01" class="w-full rounded-lg px-3 py-2 text-sm"/>
        </div>
        <div>
          <label class="text-xs text-gray-400 block mb-1">Compare At Price</label>
          <input type="number" id="editSkuComparePrice" min="0" step="0.01" class="w-full rounded-lg px-3 py-2 text-sm"/>
        </div>
      </div>
      <div>
        <label class="text-xs text-gray-400 block mb-1">Stock</label>
        <input type="number" id="editSkuStock" min="0" class="w-full rounded-lg px-3 py-2 text-sm"/>
      </div>
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" id="editSkuIsActive" class="accent-yellow-500"/>
        <span class="text-sm text-gray-300">Active</span>
      </label>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="updateSkuVariant()" class="flex-1 bg-accent-500 text-primary py-2.5 rounded-xl font-bold text-sm">Save Changes</button>
        <button type="button" onclick="closeModal('editSkuModal')" class="px-4 py-2.5 border border-white/10 rounded-xl text-gray-400 text-sm">Cancel</button>
      </div>
    </div>
  </div>
</div>

<script>
const PRODUCT_ID = '<%= product._id %>';
let currentVariantType = '<%= product.variantType || "none" %>';

// ── Utilities ────────────────────────────────────────────────────────
function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
function openModal(id)  { document.getElementById(id).classList.remove('hidden'); }

async function apiCall(method, url, body) {
  const opts = { method, headers: { 'Content-Type': 'application/json' } };
  if (body) opts.body = JSON.stringify(body);
  const r = await fetch(url, opts);
  return r.json();
}

async function apiFormCall(method, url, formData) {
  const r = await fetch(url, { method, body: formData });
  return r.json();
}

// ── Variant Type UI ──────────────────────────────────────────────────
function renderVariantTabs() {
  const vt  = currentVariantType;
  const tabs = document.getElementById('variantTabs');
  const actions = document.getElementById('variantManagerActions');

  // Build tab list
  let tabHtml = '';
  if (vt === 'color' || vt === 'color_size') {
    tabHtml += `<button type="button" onclick="switchVariantTab('colors')" id="tab-colors"
      class="variant-tab px-4 py-2 text-sm font-semibold border-b-2 border-accent-500 text-accent-500 transition-all">
      Colors (${document.querySelectorAll('[id^="color-row-"]').length || 0})
    </button>`;
  }
  if (vt === 'size' || vt === 'color_size') {
    tabHtml += `<button type="button" onclick="switchVariantTab('sizes')" id="tab-sizes"
      class="variant-tab px-4 py-2 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-300 transition-all">
      Sizes
    </button>`;
  }
  if (vt !== 'none') {
    tabHtml += `<button type="button" onclick="switchVariantTab('skus')" id="tab-skus"
      class="variant-tab px-4 py-2 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-300 transition-all">
      SKU Variants
    </button>`;
  }
  tabs.innerHTML = tabHtml;

  // Build action buttons
  let actionHtml = '';
  if (vt === 'color' || vt === 'color_size') {
    actionHtml += `<button type="button" onclick="openAddColorModal()" class="text-xs bg-blue-600 hover:bg-blue-500 text-white px-3 py-1.5 rounded-lg font-bold flex items-center gap-1.5 transition-colors">
      <i class="fa-solid fa-palette text-xs"></i> Add Color
    </button>`;
  }
  if (vt === 'size' || vt === 'color_size') {
    actionHtml += `<button type="button" onclick="openAddSizeModal()" class="text-xs bg-green-600 hover:bg-green-500 text-white px-3 py-1.5 rounded-lg font-bold flex items-center gap-1.5 transition-colors">
      <i class="fa-solid fa-ruler text-xs"></i> Add Size
    </button>`;
  }
  if (vt !== 'none') {
    actionHtml += `<button type="button" onclick="openAddSkuModal()" class="text-xs bg-accent-500 hover:bg-accent-400 text-primary px-3 py-1.5 rounded-lg font-bold flex items-center gap-1.5 transition-colors">
      <i class="fa-solid fa-barcode text-xs"></i> Add SKU
    </button>`;
  }
  actions.innerHTML = actionHtml;

  // Show first available tab
  if (vt === 'none') {
    document.getElementById('panel-colors').classList.add('hidden');
    document.getElementById('panel-sizes').classList.add('hidden');
    document.getElementById('panel-skus').classList.add('hidden');
  } else if (vt === 'color') {
    switchVariantTab('colors');
  } else if (vt === 'size') {
    switchVariantTab('sizes');
  } else {
    switchVariantTab('colors');
  }
}

function switchVariantTab(tab) {
  ['colors','sizes','skus'].forEach(t => {
    const panel = document.getElementById(`panel-${t}`);
    const btn   = document.getElementById(`tab-${t}`);
    if (panel) panel.classList.toggle('hidden', t !== tab);
    if (btn) {
      btn.classList.toggle('border-accent-500', t === tab);
      btn.classList.toggle('text-accent-500', t === tab);
      btn.classList.toggle('border-transparent', t !== tab);
      btn.classList.toggle('text-gray-500', t !== tab);
    }
  });
  if (tab === 'colors') initLazyImages();
}

async function changeVariantType(vt) {
  if (vt === currentVariantType) return;

  const confirmed = confirm(`Change variant type to "${vt}"? Existing SKU variants that don't match the new type will still be stored but may become invalid. Continue?`);
  if (!confirmed) return;

  const d = await apiCall('PUT', `/admin/products/${PRODUCT_ID}/variant-type`, { variantType: vt });
  if (d.success) {
    currentVariantType = vt;
    document.getElementById('variantTypeInput').value = vt;

    // Update button highlights
    document.querySelectorAll('.vt-btn').forEach(btn => {
      const btnVt = btn.id.replace('vt-btn-', '');
      btn.classList.toggle('border-accent-500',    btnVt === vt);
      btn.classList.toggle('bg-accent-500/10',     btnVt === vt);
      btn.classList.toggle('text-accent-400',      btnVt === vt);
      btn.classList.toggle('border-white/10',      btnVt !== vt);
      btn.classList.toggle('text-gray-400',        btnVt !== vt);
    });

    // Update flat stock field opacity
    document.getElementById('flatStockField').classList.toggle('opacity-50', vt !== 'none');
    document.getElementById('flatStockInput').disabled = vt !== 'none';

    renderVariantTabs();
    showToast(`Variant type set to "${vt}"`, 'success');
  } else {
    showToast(d.message || 'Error updating variant type', 'error');
  }
}

// ── Lazy images ───────────────────────────────────────────────────────
function initLazyImages() {
  document.querySelectorAll('.lazy-img[data-src]').forEach(img => {
    if (img.dataset.src && !img.src.startsWith('http')) {
      img.src = img.dataset.src;
      img.removeAttribute('data-src');
    }
  });
}

// ── Color Variant ─────────────────────────────────────────────────────
function openAddColorModal() { openModal('addColorModal'); }

function openEditColorModal(colorId, color, hex, isActive) {
  document.getElementById('ecColorId').value   = colorId;
  document.getElementById('ecColor').value     = color;
  document.getElementById('ecColorHex').value  = hex || '#000000';
  document.getElementById('ecIsActive').checked = isActive === 'true';
  openModal('editColorModal');
}

document.getElementById('acImages')?.addEventListener('change', function () {
  const preview = document.getElementById('acImagePreview');
  preview.innerHTML = '';
  Array.from(this.files).forEach(file => {
    const r = new FileReader();
    r.onload = e => {
      const img = document.createElement('img');
      img.src = e.target.result;
      img.className = 'w-12 h-12 object-cover rounded-lg';
      preview.appendChild(img);
    };
    r.readAsDataURL(file);
  });
});

async function addColorVariant() {
  const color = document.getElementById('acColor').value.trim();
  if (!color) { showToast('Color name is required', 'error'); return; }

  const fd = new FormData();
  fd.append('color', color);
  fd.append('colorHex', document.getElementById('acColorHex').value);
  Array.from(document.getElementById('acImages').files).forEach(f => fd.append('images', f));

  const d = await apiFormCall('POST', `/admin/products/${PRODUCT_ID}/colors`, fd);
  if (d.success) { showToast('Color added!', 'success'); setTimeout(() => location.reload(), 800); }
  else showToast(d.message || 'Error', 'error');
}

async function updateColorVariant() {
  const colorId = document.getElementById('ecColorId').value;
  const d = await apiCall('PUT', `/admin/products/${PRODUCT_ID}/colors/${colorId}`, {
    color: document.getElementById('ecColor').value,
    colorHex: document.getElementById('ecColorHex').value,
    isActive: document.getElementById('ecIsActive').checked ? 'true' : 'false',
  });
  if (d.success) { showToast('Color updated!', 'success'); closeModal('editColorModal'); setTimeout(() => location.reload(), 800); }
  else showToast(d.message || 'Error', 'error');
}

async function deleteColorVariant(colorId) {
  if (!confirm('Delete this color and all its variant SKUs?')) return;
  const d = await apiCall('DELETE', `/admin/products/${PRODUCT_ID}/colors/${colorId}`);
  if (d.success) { showToast('Color deleted', 'info'); document.getElementById(`color-row-${colorId}`)?.remove(); }
  else showToast(d.message || 'Error', 'error');
}

async function addColorImages(input, productId, colorId) {
  const fd = new FormData();
  Array.from(input.files).forEach(f => fd.append('images', f));
  const d = await apiFormCall('PUT', `/admin/products/${productId}/colors/${colorId}`, fd);
  if (d.success) { showToast('Images added!', 'success'); setTimeout(() => location.reload(), 800); }
  else showToast(d.message || 'Error', 'error');
}

async function deleteColorImage(productId, colorId, publicId, wrapperId) {
  if (!confirm('Remove this image?')) return;
  const d = await apiCall('POST', `/admin/products/${productId}/colors/delete-image`, { colorId, publicId });
  if (d.success) { showToast('Image removed', 'info'); document.getElementById(wrapperId)?.remove(); }
  else showToast(d.message || 'Error', 'error');
}

// ── Size Variant ──────────────────────────────────────────────────────
function openAddSizeModal() { openModal('addSizeModal'); }

function openEditSizeModal(sizeId, size, isActive) {
  document.getElementById('esSizeId').value    = sizeId;
  document.getElementById('esSize').value      = size;
  document.getElementById('esIsActive').checked = isActive === 'true';
  openModal('editSizeModal');
}

async function addSizeVariant() {
  const size = document.getElementById('asSize').value.trim();
  if (!size) { showToast('Size is required', 'error'); return; }
  const d = await apiCall('POST', `/admin/products/${PRODUCT_ID}/sizes`, { size });
  if (d.success) { showToast('Size added!', 'success'); setTimeout(() => location.reload(), 800); }
  else showToast(d.message || 'Error', 'error');
}

async function updateSizeVariant() {
  const sizeId = document.getElementById('esSizeId').value;
  const d = await apiCall('PUT', `/admin/products/${PRODUCT_ID}/sizes/${sizeId}`, {
    size: document.getElementById('esSize').value,
    isActive: document.getElementById('esIsActive').checked ? 'true' : 'false',
  });
  if (d.success) { showToast('Size updated!', 'success'); closeModal('editSizeModal'); setTimeout(() => location.reload(), 800); }
  else showToast(d.message || 'Error', 'error');
}

async function deleteSizeVariant(sizeId) {
  if (!confirm('Delete this size and all related SKU variants?')) return;
  const d = await apiCall('DELETE', `/admin/products/${PRODUCT_ID}/sizes/${sizeId}`);
  if (d.success) { showToast('Size deleted', 'info'); document.getElementById(`size-row-${sizeId}`)?.remove(); }
  else showToast(d.message || 'Error', 'error');
}

// ── SKU Variant ───────────────────────────────────────────────────────
function openAddSkuModal() {
  const vt = currentVariantType;
  document.getElementById('addSkuColorField').classList.toggle('hidden', vt !== 'color' && vt !== 'color_size');
  document.getElementById('addSkuSizeField').classList.toggle('hidden',  vt !== 'size'  && vt !== 'color_size');

  const subtitles = { color: 'Color variant', size: 'Size variant', color_size: 'Color + Size combination' };
  document.getElementById('addSkuSubtitle').textContent = subtitles[vt] || '';

  document.getElementById('skuCode').value         = '';
  document.getElementById('skuPrice').value        = '';
  document.getElementById('skuComparePrice').value = '';
  document.getElementById('skuStock').value        = '0';
  openModal('addSkuModal');
}

async function saveSkuVariant() {
  const price = document.getElementById('skuPrice').value;
  if (!price) { showToast('Price is required', 'error'); return; }

  const vt = currentVariantType;
  const colorId = document.getElementById('skuColorId')?.value || null;
  const sizeId  = document.getElementById('skuSizeId')?.value  || null;

  if ((vt === 'color' || vt === 'color_size') && !colorId) { showToast('Select a color', 'error'); return; }
  if ((vt === 'size'  || vt === 'color_size') && !sizeId)  { showToast('Select a size', 'error'); return; }

  const body = {
    colorId: colorId || undefined,
    sizeId:  sizeId  || undefined,
    sku:     document.getElementById('skuCode').value,
    price,
    compareAtPrice: document.getElementById('skuComparePrice').value || undefined,
    stock: document.getElementById('skuStock').value || 0,
  };

  const d = await apiCall('POST', `/admin/products/${PRODUCT_ID}/variants`, body);
  if (d.success) { showToast('SKU variant saved!', 'success'); closeModal('addSkuModal'); setTimeout(() => location.reload(), 800); }
  else showToast(d.message || 'Error', 'error');
}

function openEditSkuModal(variantId, sku, price, comparePrice, stock, isActive) {
  document.getElementById('editSkuId').value              = variantId;
  document.getElementById('editSkuCode').value            = sku;
  document.getElementById('editSkuPrice').value           = price;
  document.getElementById('editSkuComparePrice').value    = comparePrice || '';
  document.getElementById('editSkuStock').value           = stock;
  document.getElementById('editSkuIsActive').checked      = isActive === 'true';
  openModal('editSkuModal');
}

async function updateSkuVariant() {
  const variantId = document.getElementById('editSkuId').value;
  const d = await apiCall('PUT', `/admin/products/${PRODUCT_ID}/variants/${variantId}`, {
    sku:           document.getElementById('editSkuCode').value,
    price:         document.getElementById('editSkuPrice').value,
    compareAtPrice: document.getElementById('editSkuComparePrice').value || undefined,
    stock:         document.getElementById('editSkuStock').value,
    isActive:      document.getElementById('editSkuIsActive').checked ? 'true' : 'false',
  });
  if (d.success) { showToast('SKU updated!', 'success'); closeModal('editSkuModal'); setTimeout(() => location.reload(), 800); }
  else showToast(d.message || 'Error', 'error');
}

async function deleteSkuVariant(variantId) {
  if (!confirm('Remove this SKU variant?')) return;
  const d = await apiCall('DELETE', `/admin/products/${PRODUCT_ID}/variants/${variantId}`);
  if (d.success) { showToast('SKU removed', 'info'); document.getElementById(`sku-row-${variantId}`)?.remove(); }
  else showToast(d.message || 'Error', 'error');
}

// ── Product Images ────────────────────────────────────────────────────
function previewEditImages(input) {
  const container = document.getElementById('editImagePreview');
  document.querySelectorAll('.staged-preview').forEach(el => el.remove());
  Array.from(input.files).forEach(file => {
    const reader = new FileReader();
    reader.onload = e => {
      const div = document.createElement('div');
      div.className = 'relative aspect-square staged-preview opacity-70';
      div.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover rounded-xl border border-accent-500/30"/><span class="absolute bottom-1 left-1 bg-accent-500 text-primary text-[10px] px-1.5 py-0.5 font-bold rounded">New</span>`;
      container.insertBefore(div, container.lastElementChild);
    };
    reader.readAsDataURL(file);
  });
}

async function deleteImage(pId, publicId, wrapperId) {
  if (!confirm('Remove this image?')) return;
  const container = document.getElementById(wrapperId);
  const loader    = container?.querySelector('.image-loader');
  const deleteBtn = container?.querySelector('button');
  if (loader) loader.classList.remove('hidden');
  if (deleteBtn) deleteBtn.style.display = 'none';
  try {
    const r = await fetch('/admin/products/delete-image', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productId: pId, publicId }),
    });
    const d = await r.json();
    if (d.success) { showToast('Image deleted', 'info'); setTimeout(() => location.reload(), 800); }
    else {
      showToast(d.message || 'Error', 'error');
      if (loader) loader.classList.add('hidden');
      if (deleteBtn) deleteBtn.style.display = '';
    }
  } catch {
    showToast('Network error', 'error');
    if (loader) loader.classList.add('hidden');
    if (deleteBtn) deleteBtn.style.display = '';
  }
}

// ── Image Drag & Drop Reorder ─────────────────────────────────────────
const _persistTimers = new WeakMap();

function initSortableGrid(container) {
  let dragging = null;
  let placeholder = null;

  const getItems = () => [...container.querySelectorAll('.sortable-image')];

  const createPlaceholder = (ref) => {
    const ph = document.createElement('div');
    ph.className = 'sortable-placeholder rounded-xl bg-white/5 border-2 border-dashed border-accent-500/40';
    ph.style.width      = ref.offsetWidth  + 'px';
    ph.style.height     = ref.offsetHeight + 'px';
    ph.style.flexShrink = '0';
    return ph;
  };

  const createGhost = (item, rect) => {
    const img = item.querySelector('img');
    const ghost = document.createElement('div');
    ghost.id = 'drag-ghost';
    ghost.style.cssText = `
      position:fixed; z-index:9999; pointer-events:none;
      width:${rect.width}px; height:${rect.height}px;
      left:${rect.left}px; top:${rect.top}px;
      border-radius:12px; box-shadow:0 8px 24px rgba(0,0,0,0.5);
      opacity:0.95; overflow:hidden;
      background: #1a1a2e center/cover no-repeat;
      transition: box-shadow 0.1s;
    `;
    if (img) {
      const src = img.src || img.dataset.src;
      if (src) ghost.style.backgroundImage = `url('${src}')`;
    }
    return ghost;
  };

  getItems().forEach(item => {
    item.addEventListener('mousedown',  e => startDrag(e, item));
    item.addEventListener('touchstart', e => startDrag(e, item), { passive: false });
  });

  function startDrag(e, item) {
    if (e.target.closest('button')) return;
    e.preventDefault();

    // Clean up any leftover ghost
    document.getElementById('drag-ghost')?.remove();

    // Capture rect BEFORE any DOM changes
    const rect = item.getBoundingClientRect();
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;

    // Anchor ghost to element's top-left corner, not cursor
    // This makes ghost appear exactly on top of the item
    const offsetX = clientX - rect.left;
    const offsetY = clientY - rect.top;

    dragging = item;
    placeholder = createPlaceholder(item);

    // Insert placeholder exactly where item is, THEN hide item in place
    item.parentNode.insertBefore(placeholder, item);
    item.style.display = 'none';

    const ghost = createGhost(item, rect);
    document.body.appendChild(ghost);

    function onMove(e2) {
      const cx = e2.touches ? e2.touches[0].clientX : e2.clientX;
      const cy = e2.touches ? e2.touches[0].clientY : e2.clientY;

      ghost.style.left = (cx - offsetX) + 'px';
      ghost.style.top  = (cy - offsetY) + 'px';

      // Find nearest sibling (excluding hidden dragging item and placeholder)
      const siblings = getItems().filter(i => i !== dragging);
      let nearest = null, nearestDist = Infinity;
      siblings.forEach(sib => {
        const r = sib.getBoundingClientRect();
        const dist = Math.hypot(cx - (r.left + r.width / 2), cy - (r.top + r.height / 2));
        if (dist < nearestDist) { nearestDist = dist; nearest = sib; }
      });

      if (nearest) {
        const r = nearest.getBoundingClientRect();
        const isFlexRow = container.classList.contains('sortable-color-images');
        const before = isFlexRow
          ? cx < r.left + r.width / 2
          : (cy < r.top + r.height / 2 || (Math.abs(cy - (r.top + r.height / 2)) < r.height / 2 && cx < r.left + r.width / 2));
        container.insertBefore(placeholder, before ? nearest : nearest.nextSibling);
      }
    }

    function onEnd() {
      document.removeEventListener('mousemove', onMove);
      document.removeEventListener('mouseup',   onEnd);
      document.removeEventListener('touchmove', onMove);
      document.removeEventListener('touchend',  onEnd);

      ghost.remove();

      // Restore item right where placeholder is, then remove placeholder
      item.style.display = '';
      placeholder.parentNode.insertBefore(item, placeholder);
      placeholder.remove();
      placeholder = null;
      dragging = null;

      updateFirstBadge(container);
      schedulePersist(container);
    }

    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup',   onEnd);
    document.addEventListener('touchmove', onMove, { passive: false });
    document.addEventListener('touchend',  onEnd);
  }
}

function schedulePersist(container) {
  // Debounce: cancel any pending save for this container, wait 400ms after last drop
  if (_persistTimers.has(container)) clearTimeout(_persistTimers.get(container));
  _persistTimers.set(container, setTimeout(() => {
    _persistTimers.delete(container);
    persistImageOrder(container);
  }, 400));
}


function updateFirstBadge(container) {
  container.querySelectorAll('.sortable-image').forEach((item, idx) => {
    let badge = item.querySelector('.first-badge');
    if (idx === 0) {
      if (!badge) {
        badge = document.createElement('span');
        badge.className = 'first-badge absolute top-1 left-1 z-10 bg-accent-500 text-primary text-[9px] font-bold px-1.5 py-0.5 rounded pointer-events-none';
        badge.innerHTML = '<i class="fa-solid fa-star text-[8px]"></i> Main';
        item.style.position = 'relative';
        item.appendChild(badge);
      }
    } else {
      badge?.remove();
    }
  });
}

async function persistImageOrder(container) {
  const isColor = container.classList.contains('sortable-color-images');
  const url = container.dataset.reorderUrl;
  const orderedPublicIds = [...container.querySelectorAll('.sortable-image')]
    .map(el => el.dataset.publicId)
    .filter(Boolean);

  if (!orderedPublicIds.length) return;

  const body = isColor
    ? { colorId: container.dataset.colorId, orderedPublicIds }
    : { orderedPublicIds };

  try {
    const r = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const d = await r.json();
    if (d.success) showToast('Image order saved', 'success');
    else showToast(d.message || 'Failed to save order', 'error');
  } catch {
    showToast('Network error saving order', 'error');
  }
}


function initAllSortables() {
  // Base product images grid
  const baseGrid = document.getElementById('editImagePreview');
  if (baseGrid) initSortableGrid(baseGrid);

  // Color variant image rows
  document.querySelectorAll('.sortable-color-images').forEach(el => initSortableGrid(el));
}

// Re-init after lazy images are loaded (colors panel)
const _origInitLazy = initLazyImages;
window.initLazyImages = function() {
  _origInitLazy();
  initAllSortables();
};

// ── Init ──────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  initLazyImages();
  renderVariantTabs();
  if (currentVariantType !== 'none') {
    document.getElementById('flatStockInput').disabled = true;
  }
  initAllSortables();
});
</script>
