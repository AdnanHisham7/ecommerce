<% layout('layouts/admin') %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-xl font-bold text-white">Edit Product</h2>
    <p class="text-gray-500 text-sm"><%= product.name %></p>
  </div>
  <div class="flex gap-2">
    <a href="/products/<%= product.slug %>" target="_blank" class="flex items-center gap-2 px-4 py-2 border border-white/10 rounded-xl text-sm text-gray-400 hover:text-gray-200 transition-all"><i class="fa-solid fa-external-link text-xs"></i> View</a>
    <a href="/admin/products" class="flex items-center gap-2 px-4 py-2 border border-white/10 rounded-xl text-sm text-gray-400 hover:text-gray-200 transition-all"><i class="fa-solid fa-arrow-left text-xs"></i> Back</a>
  </div>
</div>

<form action="/admin/products/<%= product._id %>/edit" method="POST" enctype="multipart/form-data">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-5">
      <div class="card p-6 space-y-4">
        <h3 class="font-bold text-white text-sm uppercase tracking-wider">Product Information</h3>
        <div>
          <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1.5">Product Name *</label>
          <input type="text" name="name" required value="<%= product.name %>" class="w-full rounded-xl px-4 py-3 text-sm"/>
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1.5">Brand</label>
          <input type="text" name="brand" value="<%= product.brand || '' %>" class="w-full rounded-xl px-4 py-3 text-sm"/>
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1.5">Short Description</label>
          <input type="text" name="shortDescription" value="<%= product.shortDescription || '' %>" class="w-full rounded-xl px-4 py-3 text-sm"/>
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1.5">Full Description *</label>
          <textarea name="description" rows="5" required class="w-full rounded-xl px-4 py-3 text-sm resize-none"><%= product.description %></textarea>
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1.5">Tags</label>
          <input type="text" name="tags" value="<%= product.tags?.join(', ') || '' %>" class="w-full rounded-xl px-4 py-3 text-sm"/>
        </div>
      </div>

      <div class="card p-6">
        <h3 class="font-bold text-white mb-4 text-sm uppercase tracking-wider">Pricing & Stock</h3>
        <%
          const editVT = product.variantType || 'none';
          const editShowBasePrice  = editVT === 'none';
          const editShowBaseStock  = editVT === 'none';
          const editShowBaseImages = editVT === 'none' || editVT === 'size';
        %>
        <% if (!editShowBasePrice) { %>
        <div class="mb-4 flex items-start gap-3 bg-blue-500/10 border border-blue-500/20 rounded-xl p-3">
          <i class="fa-solid fa-circle-info text-blue-400 mt-0.5 text-sm"></i>
          <p class="text-xs text-gray-300">
            <strong class="text-blue-300">Variant product</strong> — base price, compare-at price, and stock are set <strong>per variant SKU</strong> in the Variant Manager below. Low stock threshold and weight still apply globally.
          </p>
        </div>
        <% } %>
        <div class="grid grid-cols-2 gap-4">
          <% if (editShowBasePrice) { %>
          <div>
            <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1.5">Base Price (₹) *</label>
            <input type="number" name="basePrice" required min="0" step="0.01" value="<%= product.basePrice %>" class="w-full rounded-xl px-4 py-3 text-sm"/>
          </div>
          <div>
            <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1.5">Compare At Price (₹)</label>
            <input type="number" name="compareAtPrice" min="0" step="0.01" value="<%= product.compareAtPrice || '' %>" class="w-full rounded-xl px-4 py-3 text-sm"/>
          </div>
          <% } %>
          <% if (editShowBaseStock) { %>
          <div>
            <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1.5">Stock</label>
            <input type="number" name="stock" min="0" value="<%= product.stock || 0 %>" class="w-full rounded-xl px-4 py-3 text-sm"/>
          </div>
          <% } %>
          <div>
            <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1.5">Low Stock Alert At</label>
            <input type="number" name="lowStockThreshold" min="1" value="<%= product.lowStockThreshold || 5 %>" class="w-full rounded-xl px-4 py-3 text-sm"/>
          </div>
        </div>
      </div>

      <!-- ==================== VARIANT TYPE SELECTOR ==================== -->
      <div class="card p-6">
        <h3 class="font-bold text-white mb-4 text-sm uppercase tracking-wider">Variant Type</h3>
        <p class="text-xs text-gray-500 mb-4">Select how this product is sold. Changing this affects which variant panels are shown below.</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3" id="variantTypeSelector">
          <% ['none','color','size','color_size'].forEach(vt => { %>
          <button type="button"
            onclick="changeVariantType('<%= vt %>')"
            id="vt-btn-<%= vt %>"
            class="vt-btn px-3 py-3 rounded-xl border-2 text-sm font-semibold transition-all text-center
              <%= product.variantType === vt ? 'border-accent-500 bg-accent-500/10 text-accent-400' : 'border-white/10 text-gray-400 hover:border-white/20' %>">
            <% if (vt === 'none') { %><i class="fa-solid fa-box text-xs block mb-1"></i>None<% } %>
            <% if (vt === 'color') { %><i class="fa-solid fa-palette text-xs block mb-1"></i>Color<% } %>
            <% if (vt === 'size') { %><i class="fa-solid fa-ruler text-xs block mb-1"></i>Size<% } %>
            <% if (vt === 'color_size') { %><i class="fa-solid fa-table-cells text-xs block mb-1"></i>Color + Size<% } %>
          </button>
          <% }) %>
        </div>
        <!-- Hidden input so the form POST also carries variantType when saving basic info -->
        <input type="hidden" name="variantType" id="variantTypeInput" value="<%= product.variantType || 'none' %>"/>
      </div>

      <!-- ==================== VARIANT MANAGER ==================== -->
      <div class="card p-6" id="variantManager">
        <div class="flex items-center justify-between mb-5">
          <h3 class="font-bold text-white text-sm uppercase tracking-wider">Variant Manager</h3>
          <div class="flex gap-2" id="variantManagerActions">
            <!-- Buttons rendered by JS based on variantType -->
          </div>
        </div>

        <!-- Tabs – rendered dynamically -->
        <div class="flex border-b border-white/10 mb-5" id="variantTabs">
          <!-- injected by renderVariantTabs() -->
        </div>

        <!-- ── Colors Panel ── -->
        <div id="panel-colors" class="hidden">
          <% if (!product.colorVariants?.length) { %>
          <p class="text-gray-500 text-sm text-center py-6">No colors added yet. Click "Add Color" above.</p>
          <% } else { %>
          <div class="grid grid-cols-1 gap-3" id="colorsList">
            <% product.colorVariants.forEach(cv => { %>
            <div class="bg-white/5 rounded-xl p-4 border border-white/10" id="color-row-<%= cv._id %>">
              <div class="flex items-start gap-4">
                <div class="flex items-center gap-3 flex-1">
                  <div class="w-10 h-10 rounded-full border-2 border-white/20 flex-shrink-0"
                    style="background:<%= cv.colorHex || '#888' %>"></div>
                  <div>
                    <p class="font-semibold text-gray-200 text-sm"><%= cv.color %></p>
                    <p class="text-xs text-gray-500"><%= cv.colorHex || 'No hex' %> · <%= cv.images?.length || 0 %> image(s)</p>
                  </div>
                  <span class="badge <%= cv.isActive ? 'bg-green-500/20 text-green-400' : 'bg-red-500/20 text-red-400' %> ml-2">
                    <%= cv.isActive ? 'Active' : 'Off' %>
                  </span>
                </div>
                <div class="flex items-center gap-2 flex-shrink-0">
                  <button type="button" onclick="openEditColorModal('<%= cv._id %>', '<%= cv.color %>', '<%= cv.colorHex || '' %>', '<%= cv.isActive %>')"
                    class="p-2 text-blue-400 hover:bg-blue-900/20 rounded-lg transition-colors" title="Edit">
                    <i class="fa-solid fa-pen text-xs"></i>
                  </button>
                  <button type="button" onclick="deleteColorVariant('<%= cv._id %>')"
                    class="p-2 text-red-400 hover:bg-red-900/20 rounded-lg transition-colors" title="Delete">
                    <i class="fa-solid fa-trash-can text-xs"></i>
                  </button>
                </div>
              </div>
              <!-- Color images -->
              <div class="mt-3">
                <div class="flex gap-2 flex-wrap sortable-color-images mt-3" 
                    id="color-images-<%= cv._id %>"
                    data-color-id="<%= cv._id %>"
                    data-reorder-url="/admin/products/<%= product._id %>/colors/reorder-images">
                  <% cv.images?.forEach((img, idx) => { %>
                  <div class="relative group w-16 h-16 flex-shrink-0 sortable-image" 
                      data-public-id="<%= img.publicId %>"
                      id="cimg-<%= cv._id %>-<%= idx %>">
                    <% if (idx === 0) { %>
                    <span class="first-badge absolute -top-1 -left-1 z-10 w-4 h-4 bg-accent-500 rounded-full flex items-center justify-center pointer-events-none">
                      <i class="fa-solid fa-star text-primary text-[7px]"></i>
                    </span>
                    <% } %>
                    <img data-src="<%= img.url %>" alt="" class="lazy-img w-full h-full object-cover rounded-lg bg-gray-800 select-none pointer-events-none"/>
                    <div class="drag-handle absolute inset-0 rounded-lg cursor-grab active:cursor-grabbing opacity-0 group-hover:opacity-100 transition-opacity bg-black/30 flex items-center justify-center">
                      <i class="fa-solid fa-up-down-left-right text-white/70 text-xs"></i>
                    </div>
                    <button type="button"
                      onclick="deleteColorImage('<%= product._id %>', '<%= cv._id %>', '<%= img.publicId %>', 'cimg-<%= cv._id %>-<%= idx %>')"
                      class="absolute top-0.5 right-0.5 w-5 h-5 bg-red-500 text-white rounded-full items-center justify-center hidden group-hover:flex text-xs z-10">
                      <i class="fa-solid fa-xmark"></i>
                    </button>
                  </div>
                  <% }) %>
                  <label class="w-16 h-16 border-2 border-dashed border-white/20 rounded-lg flex flex-col items-center justify-center cursor-pointer hover:border-accent-500/50 transition-colors flex-shrink-0 add-image-btn">
                    <i class="fa-solid fa-plus text-gray-600 text-sm"></i>
                    <input type="file" multiple accept="image/*" class="hidden"
                      onchange="addColorImages(this, '<%= product._id %>', '<%= cv._id %>')"/>
                  </label>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
          <% } %>
        </div>

        <!-- ── Sizes Panel ── -->
        <div id="panel-sizes" class="hidden">
          <% if (!product.sizeVariants?.length) { %>
          <p class="text-gray-500 text-sm text-center py-6">No sizes added yet. Click "Add Size" above.</p>
          <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-xs">
              <thead>
                <tr class="text-gray-500 uppercase tracking-wider border-b border-white/10">
                  <th class="text-left py-2 pr-4">Size</th>
                  <th class="text-left py-2 pr-4">Status</th>
                  <th class="text-left py-2">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5" id="sizesList">
                <% product.sizeVariants.forEach(sv => { %>
                <tr id="size-row-<%= sv._id %>">
                  <td class="py-2.5 pr-4 text-gray-200 font-semibold"><%= sv.size %></td>
                  <td class="py-2.5 pr-4">
                    <span class="badge <%= sv.isActive ? 'bg-green-500/20 text-green-400' : 'bg-red-500/20 text-red-400' %>">
                      <%= sv.isActive ? 'Active' : 'Off' %>
                    </span>
                  </td>
                  <td class="py-2.5 flex items-center gap-2">
                    <button type="button" onclick="openEditSizeModal('<%= sv._id %>', '<%= sv.size %>', '<%= sv.isActive %>')"
                      class="text-blue-400 hover:text-blue-300 p-1 hover:bg-blue-900/20 rounded transition-colors">
                      <i class="fa-solid fa-pen text-xs"></i>
                    </button>
                    <button type="button" onclick="deleteSizeVariant('<%= sv._id %>')"
                      class="text-red-400 hover:text-red-300 p-1 hover:bg-red-900/20 rounded transition-colors">
                      <i class="fa-solid fa-trash-can text-xs"></i>
                    </button>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>

        <!-- ── SKU Variants Panel (for color / size / color_size) ── -->
        <div id="panel-skus" class="hidden">
          <%
            const vt = product.variantType || 'none';
            const showColorCol = vt === 'color' || vt === 'color_size';
            const showSizeCol  = vt === 'size'  || vt === 'color_size';
          %>
          <% if (!product.variants?.length) { %>
          <div class="text-center py-8 text-gray-500 text-sm">
            <i class="fa-solid fa-barcode text-2xl mb-2 block text-gray-700"></i>
            No SKU variants yet.
            <% if (vt === 'color_size' && (!product.colorVariants?.length || !product.sizeVariants?.length)) { %>
              Add at least one color and one size first.
            <% } else { %>
              Click "Add SKU" above to create the first variant.
            <% } %>
          </div>
          <% } else { %>
          <p class="text-xs text-gray-500 mb-4">Each row is a sellable SKU. Price and stock are set per SKU.</p>
          <div class="overflow-x-auto">
            <table class="w-full text-xs border-collapse" id="skuTable">
              <thead>
                <tr class="text-gray-500 uppercase tracking-wider border-b border-white/10">
                  <% if (showColorCol) { %><th class="text-left py-2 px-3">Color</th><% } %>
                  <% if (showSizeCol)  { %><th class="text-left py-2 px-3">Size</th><% } %>
                  <th class="text-left py-2 px-3">SKU</th>
                  <th class="text-right py-2 px-3">Price (₹)</th>
                  <th class="text-right py-2 px-3">Stock</th>
                  <th class="text-center py-2 px-3">Status</th>
                  <th class="text-center py-2 px-3">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5">
                <% product.variants.forEach(v => {
                  const colorVariant = v.colorId ? product.colorVariants.find(c => c._id.toString() === v.colorId.toString()) : null;
                  const sizeVariant  = v.sizeId  ? product.sizeVariants.find(s => s._id.toString()  === v.sizeId.toString())  : null;
                %>
                <tr id="sku-row-<%= v._id %>">
                  <% if (showColorCol) { %>
                  <td class="py-2.5 px-3">
                    <% if (colorVariant) { %>
                    <div class="flex items-center gap-2">
                      <span class="w-4 h-4 rounded-full border border-white/20 flex-shrink-0" style="background:<%= colorVariant.colorHex || '#888' %>"></span>
                      <span class="text-gray-200"><%= colorVariant.color %></span>
                    </div>
                    <% } else { %><span class="text-gray-600">—</span><% } %>
                  </td>
                  <% } %>
                  <% if (showSizeCol) { %>
                  <td class="py-2.5 px-3 text-gray-200 font-semibold"><%= sizeVariant?.size || '—' %></td>
                  <% } %>
                  <td class="py-2.5 px-3 text-gray-400 font-mono"><%= v.sku || '—' %></td>
                  <td class="py-2.5 px-3 text-right text-white font-bold">₹<%= v.price?.toLocaleString('en-IN') %></td>
                  <td class="py-2.5 px-3 text-right font-semibold <%= v.stock <= 0 ? 'text-red-400' : v.stock <= 5 ? 'text-yellow-400' : 'text-green-400' %>">
                    <%= v.stock %>
                  </td>
                  <td class="py-2.5 px-3 text-center">
                    <span class="badge <%= v.isActive ? 'bg-green-500/20 text-green-400' : 'bg-red-500/20 text-red-400' %>">
                      <%= v.isActive ? 'Active' : 'Off' %>
                    </span>
                  </td>
                  <td class="py-2.5 px-3">
                    <div class="flex items-center justify-center gap-2">
                      <button type="button"
                        onclick="openEditSkuModal('<%= v._id %>', '<%= v.sku || '' %>', '<%= v.price %>', '<%= v.compareAtPrice || '' %>', '<%= v.stock %>', '<%= v.isActive %>')"
                        class="p-1 text-blue-400 hover:bg-blue-900/20 rounded transition-colors">
                        <i class="fa-solid fa-pen text-xs"></i>
                      </button>
                      <button type="button" onclick="deleteSkuVariant('<%= v._id %>')"
                        class="p-1 text-red-400 hover:bg-red-900/20 rounded transition-colors">
                        <i class="fa-solid fa-trash-can text-xs"></i>
                      </button>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Product Images — shown for 'none' and 'size' variant types only -->
      <% if (editShowBaseImages) { %>
      <div class="card p-6">
        <h3 class="font-bold text-white mb-1 text-sm uppercase tracking-wider">Product Images</h3>
        <% if (editVT === 'size') { %>
        <p class="text-xs text-gray-500 mb-3">These images are shared across all size variants.</p>
        <% } %>
        <div class="grid grid-cols-4 gap-3 mb-4" id="editImagePreview" 
          data-reorder-url="/admin/products/<%= product._id %>/reorder-images"
          data-context="base">
          <% product.images?.forEach((img, index) => { %>
          <div class="relative group aspect-square sortable-image" 
              data-public-id="<%= img.publicId %>"
              id="img-wrapper-<%= index %>">
            <!-- First image crown badge -->
            <% if (index === 0) { %>
            <span class="first-badge absolute top-1 left-1 z-10 bg-accent-500 text-primary text-[9px] font-bold px-1.5 py-0.5 rounded pointer-events-none">
              <i class="fa-solid fa-star text-[8px]"></i> Main
            </span>
            <% } %>
            <img src="<%= img.url %>" class="w-full h-full object-cover rounded-xl select-none pointer-events-none"/>
            <!-- Drag handle -->
            <div class="drag-handle absolute inset-0 rounded-xl cursor-grab active:cursor-grabbing opacity-0 group-hover:opacity-100 transition-opacity flex items-end justify-start p-1.5 bg-gradient-to-t from-black/40 to-transparent">
              <i class="fa-solid fa-grip-dots-vertical text-white/70 text-xs"></i>
            </div>
            <div class="image-loader hidden absolute inset-0 transparent-black rounded-xl flex items-center justify-center z-10">
              <i class="fa-solid fa-spinner fa-spin text-accent-500 text-xl"></i>
            </div>
            <button type="button" onclick="deleteImage('<%= product._id %>', '<%= img.publicId %>', 'img-wrapper-<%= index %>')"
              class="absolute top-1.5 right-1.5 w-7 h-7 bg-red-500 text-white rounded-full hidden group-hover:flex items-center justify-center shadow-lg z-20">
              <i class="fa-solid fa-xmark text-xs"></i>
            </button>
          </div>
          <% }) %>
          <label class="aspect-square border-2 border-dashed border-white/10 rounded-xl flex flex-col items-center justify-center cursor-pointer hover:border-accent-500/50 transition-colors add-image-btn">
            <i class="fa-solid fa-plus text-gray-600 text-xl mb-1"></i>
            <span class="text-xs text-gray-600">Add</span>
            <input type="file" id="editImagesInput" name="images" multiple accept="image/*" class="hidden" onchange="previewEditImages(this)"/>
          </label>
        </div>
        <p class="text-xs text-gray-600 mt-1"><i class="fa-solid fa-grip-dots-vertical mr-1"></i>Drag images to reorder. First image is used as the product card thumbnail.</p>
      </div>
      <% } else { %>
      <div class="card p-5">
        <div class="flex items-start gap-3 bg-blue-500/10 border border-blue-500/20 rounded-xl p-3">
          <i class="fa-solid fa-palette text-blue-400 mt-0.5 text-sm"></i>
          <div>
            <p class="text-sm font-semibold text-gray-200 mb-1">Images managed per color variant</p>
            <p class="text-xs text-gray-500">Since this product uses color variants, product images are uploaded for each color separately in the Variant Manager below.</p>
          </div>
        </div>
      </div>
      <% } %>
    </div>

    <!-- Sidebar -->
    <div class="space-y-5">
      <div class="card p-5 space-y-4">
        <h3 class="font-bold text-white text-sm uppercase tracking-wider">Organization</h3>
        <div>
          <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1.5">Category *</label>
          <select name="category" required class="w-full rounded-xl px-4 py-3 text-sm">
            <% categories.filter(c=>!c.parent).forEach(cat => { %>
            <option value="<%= cat._id %>" <%= product.category?.toString() === cat._id.toString() ? 'selected' : '' %>><%= cat.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="space-y-3">
          <% [
            ['isFeatured', 'Featured Product', product?.isFeatured || false],
            ['isNewArrival', 'New Arrival', product?.isNewArrival || false],
            ['isBestSeller', 'Best Seller', product?.isBestSeller || false],
          ].forEach(([name, label, checked]) => { %>
          <label class="flex items-center gap-3 cursor-pointer select-none">
            <div class="relative w-11 h-6 bg-gray-700 rounded-full" style="box-shadow:inset 0 2px 4px rgba(0,0,0,0.2);">
              <input type="checkbox" name="<%= name %>" value="true" <%= checked ? 'checked' : '' %> class="sr-only peer"/>
              <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow-md transition-all duration-300 peer-checked:translate-x-5"></div>
            </div>
            <span class="text-sm text-gray-300"><%= label %></span>
          </label>
          <% }) %>
          <label class="flex items-center gap-3 cursor-pointer select-none">
            <div class="relative w-11 h-6 bg-gray-700 rounded-full">
              <input type="checkbox" name="isActive" value="true" <%= product?.isActive ? 'checked' : '' %> class="sr-only peer"/>
              <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow-md transition-all duration-300 peer-checked:translate-x-5"></div>
            </div>
            <span class="text-sm text-gray-300">Active / Visible</span>
          </label>
        </div>
      </div>

      <div class="card p-5 text-xs text-gray-500 space-y-2">
        <h3 class="font-bold text-white text-sm uppercase tracking-wider mb-3">Stats</h3>
        <p>Views: <span class="text-gray-300 font-semibold"><%= product.viewCount || 0 %></span></p>
        <p>Sales: <span class="text-gray-300 font-semibold"><%= product.salesCount || 0 %></span></p>
        <p>Wishlist: <span class="text-gray-300 font-semibold"><%= product.wishlistCount || 0 %></span></p>
        <p>Reviews: <span class="text-gray-300 font-semibold"><%= product.reviewCount || 0 %></span></p>
        <p>Rating: <span class="text-gray-300 font-semibold"><%= (product.avgRating||0).toFixed(1) %>★</span></p>
        <p class="pt-2">Created: <span class="text-gray-300"><%= new Date(product.createdAt).toLocaleDateString() %></span></p>
      </div>

      <div class="flex gap-3">
        <button type="submit" class="flex-1 bg-gradient-to-r from-accent-500 to-accent-600 text-primary py-3 rounded-xl font-bold text-sm shadow-lg hover:from-accent-400 transition-all">
          <i class="fa-solid fa-floppy-disk mr-2"></i>Save Changes
        </button>
      </div>
    </div>
  </div>
</form>

<!-- ==================== MODALS ==================== -->

<!-- Add Color Modal -->
<div id="addColorModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 transparent-black" onclick="closeModal('addColorModal')"></div>
  <div class="relative bg-[#1a1a2e] border border-white/10 rounded-2xl p-6 w-full max-w-md shadow-2xl">
    <h3 class="font-bold text-white mb-4">Add Color</h3>
    <div class="space-y-3">
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="text-xs text-gray-400 block mb-1">Color Name *</label>
          <input type="text" id="acColor" placeholder="Red, Blue, White..." class="w-full rounded-lg px-3 py-2 text-sm"/>
        </div>
        <div>
          <label class="text-xs text-gray-400 block mb-1">Hex Code</label>
          <input type="color" id="acColorHex" value="#ff0000" class="w-full rounded-lg px-3 py-2 text-sm h-10 cursor-pointer"/>
        </div>
      </div>
      <div>
        <label class="text-xs text-gray-400 block mb-1">Color Images</label>
        <input type="file" id="acImages" multiple accept="image/*" class="w-full text-xs text-gray-400 file:mr-2 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:bg-accent-500 file:text-primary"/>
        <div id="acImagePreview" class="flex gap-2 mt-2 flex-wrap"></div>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="addColorVariant()" class="flex-1 bg-blue-600 hover:bg-blue-500 text-white py-2.5 rounded-xl font-bold text-sm transition-colors">Add Color</button>
        <button type="button" onclick="closeModal('addColorModal')" class="px-4 py-2.5 border border-white/10 rounded-xl text-gray-400 text-sm">Cancel</button>
      </div>
    </div>
  </div>
</div>

