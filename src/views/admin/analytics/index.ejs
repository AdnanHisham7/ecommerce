<% layout('layouts/admin') %>

<div class="flex items-center justify-between mb-6 flex-wrap gap-3">
  <div>
    <h2 class="text-xl font-bold text-white">Analytics & Reports</h2>
    <p class="text-gray-500 text-sm">Sales & performance insights</p>
  </div>
  <div class="flex gap-2">
    <% [
      { key: '7', label: '7d' },
      { key: '30', label: '30d' },
      { key: '90', label: '90d' },
      { key: 'lifetime', label: 'Lifetime' }
    ].forEach(p => { %>
    <a href="/admin/analytics?period=<%= p.key %>"
      class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all <%= period == p.key ? 'bg-accent-500 text-primary' : 'border border-white/10 text-gray-400 hover:border-white/20' %>">
      <%= p.label %>
    </a>
    <% }) %>
  </div>
</div>

<!-- Revenue & Orders Charts -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
  <div class="card p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-bold text-white">Revenue Over Time</h3>
      <span class="text-xs text-gray-500"><%= period === 'lifetime' ? 'All time' : 'Last ' + period + ' days' %></span>
    </div>
    <% if (!revenueData || revenueData.length === 0) { %>
      <div class="text-center py-10 text-gray-500 text-sm">No revenue recorded in this period.</div>
    <% } else { %>
      <canvas id="revenueChart" height="100"></canvas>
    <% } %>
  </div>
  <div class="card p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-bold text-white">User Growth</h3>
      <span class="text-xs text-gray-500"><%= period === 'lifetime' ? 'All time' : 'Last ' + period + ' days' %></span>
    </div>
    <% if (!userGrowth || userGrowth.length === 0) { %>
      <div class="text-center py-10 text-gray-500 text-sm">No user signups in this period.</div>
    <% } else { %>
      <canvas id="userChart" height="100"></canvas>
    <% } %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
  <!-- Top Products -->
  <div class="card">
    <div class="p-5 border-b border-white/5 flex items-center justify-between">
      <h3 class="font-bold text-white">Top Selling Products</h3>
      <span class="text-xs text-gray-500"><%= period === 'lifetime' ? 'All time' : 'Last ' + period + ' days' %></span>
    </div>
    <div class="p-5 space-y-4">
      <% if (!topProducts || topProducts.length === 0) { %>
        <p class="text-sm text-gray-500 text-center py-6">No products sold in this period.</p>
      <% } else { %>
        <% 
          const maxSold = topProducts[0]?.salesCount || topProducts[0]?.soldCount || 1;
          topProducts.forEach((p, i) => { 
            const vt = p.variantType || 'none';
            let displayImg = p.images?.[0]?.url || p.thumbnail;
            if (vt === 'color' || vt === 'color_size') {
              const firstActiveColor = (p.colorVariants || []).find(cv => cv.isActive && cv.images?.length);
              if (firstActiveColor) displayImg = firstActiveColor.images[0].url;
            }
            displayImg = displayImg || '/images/placeholder.png';
            const currentSold = p.soldCount != null ? p.soldCount : (p.salesCount || 0);
            const priceToShow = p.displayPrice || p.basePrice || 0;
            const revenueToShow = p.totalRevenue != null && p.totalRevenue > 0 ? p.totalRevenue : (currentSold * priceToShow);
        %>
        <div class="flex items-center gap-4">
          <span class="text-sm font-black text-gray-600 w-5 text-center">#<%= i+1 %></span>
          <img src="<%= displayImg %>" class="w-10 h-10 rounded-lg object-cover bg-gray-800 flex-shrink-0" alt="<%= p.name %>"/>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-gray-200 truncate" title="<%= p.name %>"><%= p.name %></p>
            <div class="flex items-center gap-2 mt-1">
              <div class="flex-1 bg-gray-700 rounded-full h-1.5">
                <div class="bg-accent-500 h-1.5 rounded-full" style="width: <%= Math.min(100, Math.round((currentSold / (maxSold || 1)) * 100)) %>%"></div>
              </div>
              <span class="text-xs text-gray-400 flex-shrink-0"><%= currentSold %> sold</span>
            </div>
          </div>
          <div class="text-right flex-shrink-0">
            <span class="text-sm font-bold text-white block">₹<%= (revenueToShow > 0 ? revenueToShow : priceToShow).toLocaleString('en-IN') %></span>
            <% if (revenueToShow > 0 && priceToShow > 0) { %>
              <span class="text-sm text-gray-500 block">₹<%= priceToShow.toLocaleString('en-IN') %>/unit</span>
            <% } %>
          </div>
        </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Revenue by Category -->
  <div class="card p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-bold text-white">Revenue by Category</h3>
      <span class="text-xs text-gray-500"><%= period === 'lifetime' ? 'All time' : 'Last ' + period + ' days' %></span>
    </div>
    <% if (!topCategories || topCategories.length === 0) { %>
      <div class="text-center py-10 text-gray-500 text-sm">No category revenue in this period.</div>
    <% } else { %>
      <canvas id="categoryChart" height="160"></canvas>
    <% } %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
  <!-- Orders by Status -->
  <div class="card p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-bold text-white">Orders by Status</h3>
      <span class="text-xs text-gray-400"><%= typeof totalOrdersInPeriod !== 'undefined' ? totalOrdersInPeriod : (orderData || []).reduce((s, o) => s + o.count, 0) %> total</span>
    </div>
    <% if (!orderData || orderData.length === 0) { %>
      <div class="text-center py-10 text-gray-500 text-sm">No orders recorded in this period.</div>
    <% } else { %>
      <canvas id="orderStatusChart" height="130"></canvas>
      <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 gap-2 pt-3 border-t border-white/5">
        <% 
          const ordStatusColorMap = { pending: '#f59e0b', confirmed: '#3b82f6', processing: '#6366f1', packed: '#14b8a6', dispatched: '#8b5cf6', shipped: '#a855f7', out_for_delivery: '#06b6d4', delivered: '#10b981', cancelled: '#ef4444', returned: '#f97316', refunded: '#6b7280' };
          const ordFallbackColors = ['#f0a500','#3b82f6','#10b981','#8b5cf6','#ef4444','#06b6d4','#f97316','#84cc16','#6b7280'];
          const totalOrdersCount = orderData.reduce((acc, o) => acc + o.count, 0) || 1;
          orderData.forEach((o, i) => {
            const color = ordStatusColorMap[o._id] || ordFallbackColors[i % ordFallbackColors.length];
            const pct = Math.round((o.count / totalOrdersCount) * 100);
        %>
        <div class="p-2 rounded-lg bg-white/[0.02] border border-white/5">
          <div class="flex items-center gap-1.5 mb-1">
            <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: <%= color %>"></span>
            <span class="text-xs text-gray-400 capitalize truncate"><%= o._id?.replace(/_/g, ' ') %></span>
          </div>
          <div class="flex items-baseline justify-between">
            <span class="text-sm font-bold text-white"><%= o.count %></span>
            <span class="text-[10px] text-gray-500"><%= pct %>%</span>
          </div>
        </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Payment Methods -->
  <div class="card p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-bold text-white">Payment Methods</h3>
      <span class="text-xs text-gray-500"><%= period === 'lifetime' ? 'All time' : 'Last ' + period + ' days' %></span>
    </div>
    <div class="space-y-3">
      <% const totalPayments = (paymentMethods || []).reduce((s, p) => s + p.count, 0); %>
      <% if (!paymentMethods || paymentMethods.length === 0) { %>
        <p class="text-sm text-gray-500 text-center py-6">No payments recorded in this period.</p>
      <% } else { %>
        <% paymentMethods.forEach((pm, i) => {
          const pct = totalPayments ? Math.round((pm.count / totalPayments) * 100) : 0;
          const colors = ['#f0a500','#3b82f6','#10b981','#8b5cf6'];
        %>
        <div>
          <div class="flex items-center justify-between text-sm mb-1.5">
            <span class="text-gray-300 capitalize"><%= pm._id %></span>
            <span class="text-gray-400"><%= pm.count %> orders (<%= pct %>%)</span>
          </div>
          <div class="h-2 bg-gray-700 rounded-full overflow-hidden">
            <div class="h-2 rounded-full" style="width:<%= pct %>%; background:<%= colors[i % colors.length] || '#6b7280' %>"></div>
          </div>
          <p class="text-xs text-gray-500 mt-0.5">₹<%= (pm.total || 0).toLocaleString('en-IN') %> revenue</p>
        </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>

<script>
const chartDefaults = {
  responsive: true,
  plugins: { legend: { display: false } },
  scales: {
    x: { grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { color: '#6b7280', font: { size: 11 } } },
    y: { grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { color: '#6b7280', font: { size: 11 } } }
  }
};

const isPeriodLifetime = <%= period === 'lifetime' %>;

// Revenue Chart
const revData = <%- JSON.stringify(revenueData || []) %>;
if (document.getElementById('revenueChart') && revData.length > 0) {
  new Chart(document.getElementById('revenueChart'), {
    type: 'line',
    data: {
      labels: revData.map(d => new Date(d._id).toLocaleDateString('en-IN', {
        day: 'numeric',
        month: 'short',
        ...(isPeriodLifetime ? { year: '2-digit' } : {})
      })),
      datasets: [{
        data: revData.map(d => d.revenue),
        borderColor: '#f0a500', backgroundColor: 'rgba(240,165,0,0.08)',
        borderWidth: 2.5, pointBackgroundColor: '#f0a500', pointRadius: 4, tension: 0.4, fill: true
      }]
    },
    options: { ...chartDefaults, scales: { ...chartDefaults.scales, y: { ...chartDefaults.scales.y, ticks: { ...chartDefaults.scales.y.ticks, callback: v => '₹'+(v/1000).toFixed(0)+'k' } } } }
  });
}

// User Growth
const userData = <%- JSON.stringify(userGrowth || []) %>;
if (document.getElementById('userChart') && userData.length > 0) {
  new Chart(document.getElementById('userChart'), {
    type: 'bar',
    data: {
      labels: userData.map(d => new Date(d._id).toLocaleDateString('en-IN', {
        day: 'numeric',
        month: 'short',
        ...(isPeriodLifetime ? { year: '2-digit' } : {})
      })),
      datasets: [{ data: userData.map(d => d.count), backgroundColor: 'rgba(59,130,246,0.8)', borderRadius: 6, borderSkipped: false }]
    },
    options: chartDefaults
  });
}

// Category Doughnut
const catData = <%- JSON.stringify(topCategories || []) %>;
if (document.getElementById('categoryChart') && catData.length > 0) {
  new Chart(document.getElementById('categoryChart'), {
    type: 'doughnut',
    data: {
      labels: catData.map(c => c._id),
      datasets: [{ data: catData.map(c => c.revenue), backgroundColor: ['#f0a500','#3b82f6','#10b981','#8b5cf6','#ef4444','#06b6d4'], borderWidth: 0, hoverOffset: 4 }]
    },
    options: { responsive: true, cutout: '65%', plugins: { legend: { display: true, position: 'bottom', labels: { color: '#9ca3af', boxWidth: 12, padding: 12, font: { size: 11 } } } } }
  });
}

// Order Status Bar
const ordData = <%- JSON.stringify(orderData || []) %>;
const ordStatusColorMap = { pending: '#f59e0b', confirmed: '#3b82f6', processing: '#6366f1', packed: '#14b8a6', dispatched: '#8b5cf6', shipped: '#a855f7', out_for_delivery: '#06b6d4', delivered: '#10b981', cancelled: '#ef4444', returned: '#f97316', refunded: '#6b7280' };
const ordFallbackColors = ['#f0a500','#3b82f6','#10b981','#8b5cf6','#ef4444','#06b6d4','#f97316','#84cc16','#6b7280'];

if (document.getElementById('orderStatusChart') && ordData.length > 0) {
  new Chart(document.getElementById('orderStatusChart'), {
    type: 'bar',
    data: {
      labels: ordData.map(o => o._id?.replace(/_/g,' ')),
      datasets: [{
        data: ordData.map(o => o.count),
        backgroundColor: ordData.map((o, i) => ordStatusColorMap[o._id] || ordFallbackColors[i % ordFallbackColors.length]),
        borderRadius: 6,
        borderSkipped: false
      }]
    },
    options: {
      ...chartDefaults,
      plugins: { legend: { display: false } },
      indexAxis: 'y',
      scales: {
        x: {
          grid: { color: 'rgba(255,255,255,0.04)' },
          ticks: { color: '#6b7280', font: { size: 11 }, stepSize: 1, precision: 0 }
        },
        y: {
          grid: { color: 'rgba(255,255,255,0.04)' },
          ticks: { color: '#6b7280', font: { size: 11 } }
        }
      }
    }
  });
}
</script>
