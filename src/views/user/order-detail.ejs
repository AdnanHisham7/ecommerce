<% layout('layouts/user') %>
<% const statusColors = {
  pending:    'text-yellow-500 bg-yellow-50 dark:bg-yellow-900/20',
  confirmed:  'text-blue-500 bg-blue-50 dark:bg-blue-900/20',
  packed:     'text-teal-500 bg-teal-50 dark:bg-teal-900/20',
  dispatched: 'text-indigo-500 bg-indigo-50 dark:bg-indigo-900/20',
  delivered:  'text-green-500 bg-green-50 dark:bg-green-900/20',
  cancelled:  'text-red-500 bg-red-50 dark:bg-red-900/20',
  returned:   'text-orange-500 bg-orange-50 dark:bg-orange-900/20',
  refunded:   'text-gray-500 bg-gray-100 dark:bg-gray-800',
}; %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">

  <!-- Page header — stacked on mobile, side-by-side on desktop -->
  <div class="mb-5 md:mb-6">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
      <div class="min-w-0">
        <h1 class="text-xl md:text-2xl font-black dark:text-white truncate">
          Order <span class="text-accent-500">#<%= order.orderNumber %></span>
        </h1>
        <p class="text-gray-500 dark:text-gray-400 text-xs md:text-sm mt-0.5">
          Placed on <%= new Date(order.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'}) %>
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2 flex-shrink-0">
        <span class="text-xs md:text-sm font-semibold px-3 py-1.5 rounded-full capitalize <%= statusColors[order.orderStatus] || 'text-gray-500 bg-gray-100' %>">
          <%= order.orderStatus?.replace(/_/g,' ') %>
        </span>
        <a href="/orders" class="text-accent-500 hover:text-accent-600 text-sm font-semibold whitespace-nowrap">
          ← Back
        </a>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 md:gap-6">
    <div class="lg:col-span-2 space-y-4 md:space-y-5">

      <!-- Items -->
      <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800">
        <div class="p-4 md:p-5 border-b border-gray-100 dark:border-gray-800">
          <h2 class="font-bold dark:text-white">Order Items (<%= order.items.length %>)</h2>
        </div>
        <div class="divide-y divide-gray-100 dark:divide-gray-800">
          <% order.items.forEach(item => {
            const displayImg = item.variant?.variantImage || item.productImage || '/images/placeholder.png';
          %>
          <div class="flex items-start gap-3 md:gap-4 p-4 md:p-5">
            <div class="relative flex-shrink-0">
              <img src="<%= displayImg %>" class="w-16 h-16 md:w-20 md:h-20 rounded-xl object-cover bg-gray-100 dark:bg-gray-800"/>
              <% if (item.variant?.colorHex) { %>
              <span class="absolute -bottom-1 -right-1 w-4 h-4 md:w-5 md:h-5 rounded-full border-2 border-white dark:border-gray-900"
                style="background-color:<%= item.variant.colorHex %>"></span>
              <% } %>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-semibold dark:text-white text-sm md:text-base line-clamp-2"><%= item.productName %></p>
              <% if (item.variant && (item.variant.color || item.variant.size)) { %>
              <div class="flex items-center gap-1.5 mt-1 flex-wrap">
                <% if (item.variant.color) { %>
                <span class="inline-flex items-center gap-1 text-xs bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 px-2 py-0.5 rounded-md font-medium">
                  <% if (item.variant.colorHex) { %>
                    <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background-color:<%= item.variant.colorHex %>"></span>
                  <% } %>
                  <%= item.variant.color %>
                </span>
                <% } %>
                <% if (item.variant.size) { %>
                <span class="text-xs bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 px-2 py-0.5 rounded-md font-medium">Sz: <%= item.variant.size %></span>
                <% } %>
              </div>
              <% } %>
              <p class="text-xs md:text-sm text-gray-500 dark:text-gray-400 mt-1">
                Qty: <%= item.quantity %> × ₹<%= item.price.toLocaleString('en-IN') %>
              </p>
              <div class="flex items-center justify-between mt-2 flex-wrap gap-2">
                <span class="inline-flex items-center text-xs font-semibold px-2 py-0.5 rounded-full capitalize
                  <%= item.itemStatus === 'active' ? 'bg-green-50 dark:bg-green-900/20 text-green-600' : 'bg-red-50 dark:bg-red-900/20 text-red-600' %>">
                  <%= item.itemStatus %>
                </span>
                <div class="flex items-center gap-3">
                  <p class="font-bold dark:text-white text-sm">₹<%= (item.price * item.quantity).toLocaleString('en-IN') %></p>
                  <% if (item.itemStatus === 'active' && ['pending','confirmed'].includes(order.orderStatus) && !(order.paymentMethod === 'cod' && order.paymentStatus === 'paid')) { %>
                  <button onclick="cancelItem('<%= order._id %>', '<%= item._id %>')" class="text-xs text-red-500 hover:text-red-700 whitespace-nowrap">Cancel</button>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      </div>

      <!-- Tracking Timeline -->
      <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 p-4 md:p-5">
        <h2 class="font-bold dark:text-white mb-4 md:mb-5">Order Tracking</h2>
        <div class="relative">
          <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-gray-200 dark:bg-gray-700"></div>
          <div class="space-y-4">
            <% order.trackingHistory?.slice().reverse().forEach((t, i) => { %>
            <div class="flex items-start gap-3 md:gap-4 relative">
              <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 z-10 border-2
                <%= i === 0 ? 'bg-accent-500 border-accent-500' : 'bg-white dark:bg-gray-900 border-gray-300 dark:border-gray-700' %>">
                <i class="fa-solid fa-check text-xs <%= i === 0 ? 'text-white' : 'text-gray-400' %>"></i>
              </div>
              <div class="flex-1 pt-1 min-w-0">
                <p class="font-semibold text-sm dark:text-white capitalize"><%= t.status?.replace(/_/g,' ') %></p>
                <% if (t.message) { %>
                <p class="text-xs text-gray-500 dark:text-gray-400"><%= t.message %></p>
                <% } %>
                <% if (t.trackingNumber) { %>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                  <span class="font-medium">Tracking No:</span> <%= t.trackingNumber %>
                </p>
                <% } %>
                <% if (t.trackingLink) { %>
                <a href="<%= t.trackingLink %>" target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-1.5 mt-1.5 text-xs font-semibold text-accent-500 hover:text-accent-600">
                  <i class="fa-solid fa-truck-fast"></i> Track Package <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                </a>
                <% } %>
                <p class="text-xs text-gray-400 mt-1"><%= new Date(t.timestamp).toLocaleString('en-IN') %></p>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Panel -->
    <div class="space-y-4 md:space-y-5">

      <!-- Actions -->
      <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 p-4 md:p-5">
        <h2 class="font-bold dark:text-white mb-3 md:mb-4">Actions</h2>
        <div class="space-y-2">
          <% if (order.orderStatus === 'delivered' && order.paymentStatus === 'paid') { %>
          <a href="/orders/<%= order._id %>/invoice" class="w-full flex items-center gap-2 px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl text-sm font-medium dark:text-gray-300 hover:border-accent-400 hover:text-accent-500 transition-all">
            <i class="fa-solid fa-file-pdf text-red-500"></i> Download Invoice
          </a>
          <% } %>
          <% if (['pending','confirmed'].includes(order.orderStatus) && !(order.paymentMethod === 'cod' && order.paymentStatus === 'paid')) { %>
          <button onclick="cancelOrder('<%= order._id %>')" class="w-full flex items-center gap-2 px-4 py-2.5 border border-red-200 dark:border-red-900/50 rounded-xl text-sm font-medium text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition-all">
            <i class="fa-solid fa-ban"></i> Cancel Order
          </button>
          <% } %>
          <% if (order.paymentStatus === 'failed') { %>
          <button onclick="retryPayment('<%= order._id %>')" class="w-full flex items-center gap-2 px-4 py-2.5 bg-green-500 hover:bg-green-600 text-white rounded-xl text-sm font-bold transition-colors justify-center">
            <i class="fa-solid fa-rotate-right"></i> Retry Payment
          </button>
          <% } %>
          <a href="/shop" class="w-full flex items-center gap-2 px-4 py-2.5 btn-primary rounded-xl text-sm font-bold text-center justify-center">
            <i class="fa-solid fa-bag-shopping text-xs"></i> Continue Shopping
          </a>
        </div>
      </div>

      <!-- Order Summary -->
      <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 p-4 md:p-5">
        <h2 class="font-bold dark:text-white mb-3 md:mb-4">Order Summary</h2>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Subtotal</span><span>₹<%= order.subtotal?.toLocaleString('en-IN') || '—' %></span></div>
          <% if (order.couponDiscount > 0) { %>
          <div class="flex justify-between text-green-500"><span>Coupon (<%= order.couponCode %>)</span><span>−₹<%= order.couponDiscount.toLocaleString('en-IN') %></span></div>
          <% } %>
          <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Shipping</span><span><%= order.shippingCharge === 0 ? 'FREE' : '₹'+order.shippingCharge %></span></div>
          <% if (typeof order.taxAmount !== 'undefined' && order.taxAmount > 0) { %>
          <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Tax</span><span>₹<%= order.taxAmount?.toLocaleString('en-IN') || 0 %></span></div>
          <% } %>
          <% if (order.walletAmountUsed > 0) { %>
          <div class="flex justify-between text-blue-500"><span>Wallet</span><span>−₹<%= order.walletAmountUsed.toLocaleString('en-IN') %></span></div>
          <% } %>
          <div class="border-t border-gray-200 dark:border-gray-800 pt-2 flex justify-between font-bold text-gray-900 dark:text-white">
            <span>Total</span><span>₹<%= order.totalAmount.toLocaleString('en-IN') %></span>
          </div>
          <div class="flex justify-between text-xs text-gray-500 dark:text-gray-400 pt-1">
            <span>Payment</span>
            <span class="capitalize text-right">
              <%= order.paymentMethod %> —
              <span class="capitalize <%= order.paymentStatus==='paid'?'text-green-500':order.paymentStatus==='failed'?'text-red-500':'text-yellow-500' %>">
                <%= order.paymentStatus %>
              </span>
            </span>
          </div>
        </div>
      </div>

      <!-- Shipping Address -->
      <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 p-4 md:p-5">
        <h2 class="font-bold dark:text-white mb-3">Delivery Address</h2>
        <% const a = order.shippingAddress; %>
        <p class="font-semibold dark:text-white text-sm"><%= a.fullName %></p>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1"><%= a.addressLine1 %><% if(a.addressLine2){%>, <%= a.addressLine2 %><% } %></p>
        <p class="text-sm text-gray-600 dark:text-gray-400"><%= a.city %>, <%= a.state %> — <%= a.pincode %></p>
        <p class="text-sm text-gray-500 dark:text-gray-500 mt-1 flex items-center gap-1.5">
          <i class="fa-solid fa-phone text-xs"></i> <%= a.phone %>
        </p>
      </div>
    </div>
  </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
async function cancelOrder(id) {
  const reason = prompt('Reason for cancellation:');
  if (!reason) return;

  try {
    const r = await fetch(`/orders/${id}/cancel`, {
      method: 'POST', 
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ reason }),
    });

    // If the backend processed it and initiated a standard redirect
    if (r.redirected) { 
      window.location.href = r.url; 
      return; 
    }

    // If the response code is 2xx
    if (r.ok) {
      const data = await r.json();
      showToast(data.message, 'success');
      setTimeout(() => {
        window.location.href = data.redirectUrl;
      }, 1000);
    } else {
      // If backend threw an error (400, 404, etc.), parse the error message
      const errorData = await r.json().catch(() => ({}));
      const errorMsg = errorData.message || 'Order cannot be cancelled at this stage';
      showToast(errorMsg, 'error');
    }
  } catch (err) {
    showToast('Something went wrong. Please try again.', 'error');
  }
}

async function cancelItem(orderId, itemId) {
  const reason = prompt('Reason for cancelling this item:');
  if (!reason) return;

  try {
    const r = await fetch(`/orders/${orderId}/cancel`, {
      method: 'POST', 
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ reason, itemId }),
    });

    if (r.redirected) { 
      window.location.href = r.url; 
      return; 
    }

    if (r.ok) {
      const data = await r.json();
      showToast(data.message, 'success');
      setTimeout(() => {
        window.location.href = data.redirectUrl;
      }, 1000);
    } else {
      const errorData = await r.json().catch(() => ({}));
      const errorMsg = errorData.message || 'Item cannot be cancelled';
      showToast(errorMsg, 'error');
    }
  } catch (err) {
    console.log("somethign went wrong on cancel item", err)
    showToast('Something went wrong. Please try again.', 'error');
  }
}

async function markPaymentFailed(orderId, reason) {
  try {
    await fetch('/checkout/fail-payment', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ orderId, reason }),
    });
  } catch (_) {}
}

async function retryPayment(orderId) {
  const btn = document.querySelector(`button[onclick="retryPayment('${orderId}')"]`);
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner animate-spin"></i> Initiating...'; }
  try {
    const r = await fetch(`/orders/${orderId}/retry-payment`, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    const data = await r.json();
    if (!data.success) {
      showToast(data.message || 'Could not initiate retry', 'error');
      if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-rotate-right"></i> Retry Payment'; }
      return;
    }
    const options = {
      key: data.razorpayKeyId, amount: data.amount, currency: data.currency || 'INR',
      name: '<%= brand.name %>',
      description: `Order #<%= order.orderNumber %>`,
      order_id: data.razorpayOrderId,
      handler: async function(response) {
        try {
          const vr = await fetch('/checkout/verify-payment', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId: data.orderId, razorpayPaymentId: response.razorpay_payment_id, razorpayOrderId: response.razorpay_order_id, razorpaySignature: response.razorpay_signature }),
          });
          const vd = await vr.json();
          if (vd.success) { window.location.href = vd.redirectUrl; }
          else { showToast(vd.message || 'Verification failed', 'error'); setTimeout(() => window.location.reload(), 2000); }
        } catch { showToast('Network error during verification', 'error'); }
      },
      prefill: { name: '<%= currentUser?.name || "" %>', email: '<%= currentUser?.email || "" %>', contact: '<%= currentUser?.phone || "" %>' },
      theme: { color: '<%= brand.colors.accent %>' },
      modal: {
        ondismiss: async function() {
          await markPaymentFailed(data.orderId, 'Payment window closed by user');
          showToast('Payment was not completed. You can retry anytime.', 'info');
          if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-rotate-right"></i> Retry Payment'; }
          setTimeout(() => window.location.reload(), 1500);
        },
      },
    };
    const rzp = new Razorpay(options);
    rzp.on('payment.failed', async function(response) {
      await markPaymentFailed(data.orderId, response.error?.description || 'Payment failed');
      showToast(`Payment failed: ${response.error?.description || 'Unknown error'}`, 'error');
      if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-rotate-right"></i> Retry Payment'; }
      setTimeout(() => window.location.reload(), 1500);
    });
    rzp.open();
  } catch (err) {
    showToast('Error initiating payment retry.', 'error');
    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-rotate-right"></i> Retry Payment'; }
  }
}
</script>
