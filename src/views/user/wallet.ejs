<% layout('layouts/user') %>
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-5 md:py-8">
  <h1 class="text-3xl font-black dark:text-white mb-8">My <span class="text-accent-500">Wallet</span></h1>

  <!-- Balance Card -->
  <div class="rounded-3xl p-8 text-white mb-8 relative overflow-hidden shadow-2xl bg-gray-900">
    <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
    <div class="absolute bottom-0 left-0 w-40 h-40 bg-accent-500/10 rounded-full translate-y-1/2 -translate-x-1/2"></div>
    <div class="relative">
      <p class="text-gray-300 text-sm font-medium mb-2">Available Balance</p>
      <p class="text-5xl font-black mb-4">₹<%= walletBalance.toLocaleString('en-IN') %></p>
      <div class="flex items-center gap-3 flex-wrap">
        <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-xl px-4 py-2">
          <i class="fa-solid fa-shield-halved text-accent-400 text-sm"></i>
          <span class="text-sm text-gray-300">Secure Wallet</span>
        </div>
        <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-xl px-4 py-2">
          <i class="fa-solid fa-bolt text-accent-400 text-sm"></i>
          <span class="text-sm text-gray-300">Instant Use at Checkout</span>
        </div>
      </div>
    </div>
  </div>

  <!-- How to earn -->
  <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 p-6 mb-6">
    <h2 class="font-bold dark:text-white mb-4">How to Earn Wallet Credits</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <% let earnItems = [
        ['fa-rotate-left','text-blue-500','Order Refunds','Cancelled orders are refunded to wallet'],
        ['fa-star','text-purple-500','Promotions','Watch for special wallet credit offers'],
      ];
      if (featureFlags.referralProgram) {
        earnItems.unshift(['fa-gift','text-accent-500','Refer & Earn','Earn ₹100 for each successful referral']);
      }
      earnItems.forEach(([icon, color, title, desc]) => { %>
      <div class="flex items-start gap-3 bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4">
        <i class="fa-solid <%= icon %> <%= color %> text-xl mt-0.5"></i>
        <div><p class="font-semibold text-sm dark:text-white"><%= title %></p><p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5"><%= desc %></p></div>
      </div>
      <% }) %>
    </div>
    <% if (featureFlags.referralProgram) { %>
    <a href="/referral" class="inline-flex items-center gap-2 btn-primary px-5 py-2.5 rounded-xl font-semibold text-sm mt-4">
      <i class="fa-solid fa-gift"></i> Start Referring
    </a>
    <% } %>
  </div>

  <!-- Transaction History -->
  <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800">
    <div class="p-5 border-b border-gray-200 dark:border-gray-800">
      <h2 class="font-bold dark:text-white">Transaction History</h2>
    </div>
    <% if (transactions && transactions.length) { %>
    <div class="divide-y divide-gray-100 dark:divide-gray-800">
      <% transactions.forEach(tx => { %>
      <div class="flex items-center gap-4 p-4">
        <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0
          <%= tx.type === 'credit' ? 'bg-green-100 dark:bg-green-900/30' : 'bg-red-100 dark:bg-red-900/30' %>">
          <i class="fa-solid fa-<%= tx.type === 'credit' ? 'arrow-down' : 'arrow-up' %>
            <%= tx.type === 'credit' ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400' %> text-sm"></i>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium dark:text-gray-200 truncate"><%= tx.description %></p>
          <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">
            <%= new Date(tx.createdAt).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) %>
          </p>
        </div>
        <div class="text-right flex-shrink-0">
          <p class="font-bold text-sm <%= tx.type === 'credit' ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400' %>">
            <%= tx.type === 'credit' ? '+' : '-' %>₹<%= tx.amount.toLocaleString('en-IN') %>
          </p>
          <p class="text-xs text-gray-400 dark:text-gray-500">Bal: ₹<%= tx.balanceAfter?.toLocaleString('en-IN') || '—' %></p>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="text-center py-16 text-gray-500 dark:text-gray-400">
      <i class="fa-solid fa-wallet text-4xl mb-3 block opacity-30"></i>
      <p>No transactions yet</p>
    </div>
    <% } %>
  </div>
</div>
