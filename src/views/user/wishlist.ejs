<% layout('layouts/user') %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 md:py-8">
  <h1 class="text-3xl font-black dark:text-white mb-8">My <span class="text-accent-500">Wishlist</span> <span class="text-lg font-normal text-gray-500">(<%= wishlist.products.length %> items)</span></h1>
  
  <% if (wishlist.products.length) { %>
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
    <% wishlist.products.forEach(item => { 
      const product = item.product; 
      if (!product) return; 

      // --- STOLEN LOGIC FROM PRODUCT GRID ---
      const price = product.discountedPrice || product.basePrice;
      const hasDiscount = product.discountPercent > 0 || (product.compareAtPrice && product.compareAtPrice > product.basePrice);
      const discountPct = product.discountPercent || (product.compareAtPrice ? Math.round(((product.compareAtPrice - product.basePrice) / product.compareAtPrice) * 100) : 0);

      const vt = product.variantType || 'none';
      const isVariantProduct = vt !== 'none';

      // Advanced Display Image Extraction
      let displayImg = product.images?.[0]?.url || product.thumbnail;
      if (vt === 'color' || vt === 'color_size') {
        const firstActiveColor = (product.colorVariants || []).find(cv => cv.isActive && cv.images?.length);
        if (firstActiveColor) displayImg = firstActiveColor.images[0].url;
      }
      displayImg = displayImg || '/images/placeholder.png';

      const activeColors = (vt === 'color' || vt === 'color_size')
        ? (product.colorVariants || []).filter(cv => cv.isActive)
        : [];

      // Advanced Price Processing
      let displayPrice, displayCompareAt;
      if (vt === 'color' || vt === 'color_size') {
        const firstActiveColor = (product.colorVariants || []).find(cv => cv.isActive && cv.images?.length);
        const firstVariant = firstActiveColor
          ? (product.variants || []).find(v => v.isActive && v.colorId?.toString() === firstActiveColor._id.toString())
          : null;
        displayPrice = firstVariant?.price ?? price;
        displayCompareAt = firstVariant?.compareAtPrice ?? null;
      } else if (vt === 'size') {
        const firstVariant = (product.variants || []).find(v => v.isActive);
        displayPrice = firstVariant?.price ?? price;
        displayCompareAt = firstVariant?.compareAtPrice ?? null;
      } else {
        displayPrice = price;
        displayCompareAt = hasDiscount && product.compareAtPrice ? product.compareAtPrice : null;
      }

      const showQuickAdd = vt === 'none';
    %>
    
    <div class="product-card group relative bg-white dark:bg-gray-900 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl dark:hover:shadow-accent-500/10 transition-all duration-300 hover:-translate-y-1 border border-gray-100 dark:border-gray-800 flex flex-col h-full">
      
      <div class="relative overflow-hidden bg-gray-100 dark:bg-gray-800 aspect-square flex-shrink-0">
        <a href="/products/<%= product.slug %>" class="block w-full h-full">
          <img src="<%= displayImg %>" alt="<%= product.name %>" class="product-image w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"/>
        </a>

        <div class="absolute top-2 left-2 flex flex-col gap-1">
          <% if (product.isNewArrival) { %><span class="badge bg-green-500 text-white">New</span><% } %>
          <% if (product.isFeatured) { %><span class="badge bg-accent-500 text-white">Featured</span><% } %>
          <% if (discountPct > 0) { %><span class="badge bg-red-500 text-white"><%= discountPct %>% OFF</span><% } %>
          <% if (product.stockStatus === 'out_of_stock') { %><span class="badge bg-gray-500 text-white">Sold Out</span><% } %>
          <% if (product.stockStatus === 'low_stock') { %><span class="badge bg-yellow-500 text-white">Low Stock</span><% } %>
        </div>

        <button onclick="toggleWishlist('<%= product._id %>', this)" class="absolute top-2 right-2 w-8 h-8 bg-white dark:bg-gray-800 rounded-full flex items-center justify-center shadow-md hover:scale-110 transition-all text-red-500">
          <i class="fa-solid fa-heart text-sm"></i>
        </button>

        <div class="absolute inset-x-0 bottom-0 translate-y-full group-hover:translate-y-0 transition-transform duration-300 p-3">
          <% if (product.stockStatus !== 'out_of_stock') { %>
            <% if (showQuickAdd) { %>
              <button onclick="addToCart('<%= product._id %>')" class="w-full btn-primary py-2.5 rounded-xl text-sm font-semibold flex items-center justify-center gap-2 shadow-lg">
                <i class="fa-solid fa-bag-shopping text-xs"></i>Add to Cart
              </button>
            <% } else { %>
              <a href="/products/<%= product.slug %>" class="w-full btn-primary py-2.5 rounded-xl text-sm font-semibold flex items-center justify-center gap-2 shadow-lg bg-accent-500 hover:bg-accent-600 text-white transition-colors">
                <i class="fa-solid fa-eye text-xs"></i>View Options
              </a>
            <% } %>
          <% } else { %>
            <div class="w-full bg-gray-200 dark:bg-gray-700 py-2.5 rounded-xl text-sm font-semibold text-center text-gray-500 dark:text-gray-400">Out of Stock</div>
          <% } %>
        </div>
      </div>

      <div class="p-3 flex flex-col justify-between flex-1">
        <div>
          <p class="text-xs text-gray-400 mb-1 capitalize"><%= product.brand || '—' %></p>
          <a href="/products/<%= product.slug %>" class="font-semibold text-sm dark:text-gray-100 line-clamp-2 hover:text-accent-500 transition-colors block mb-2"><%= product.name %></a>
          
          <div class="flex items-center gap-1 mb-2">
            <div class="flex">
              <% for(let i = 1; i <= 5; i++) { %>
                <i class="fa-<%= i <= Math.round(product.avgRating || 0) ? 'solid' : 'regular' %> fa-star text-accent-400" style="font-size:10px"></i>
              <% } %>
            </div>
            <span class="text-xs text-gray-400">(<%= product.reviewCount || 0 %>)</span>
          </div>

          <% if (activeColors.length > 0) { %>
          <div class="flex items-center gap-1 mb-2">
            <% activeColors.slice(0, 6).forEach(cv => { %>
            <span title="<%= cv.color %>"
                  style="background-color: <%= cv.colorHex || cv.color %>;"
                  class="w-4 h-4 rounded-full border border-gray-300 dark:border-gray-600 inline-block flex-shrink-0"></span>
            <% }) %>
            <% if (activeColors.length > 6) { %>
            <span class="text-xs text-gray-400">+<%= activeColors.length - 6 %></span>
            <% } %>
          </div>
          <% } %>
        </div>

        <div class="flex items-center gap-2 mt-auto">
          <span class="font-bold dark:text-white text-base">
            ₹<%= displayPrice.toLocaleString('en-IN') %>
          </span>
          <% if (displayCompareAt && displayCompareAt > displayPrice) { %>
            <span class="text-xs text-gray-400 line-through">₹<%= displayCompareAt.toLocaleString('en-IN') %></span>
          <% } %>
        </div>
      </div>

    </div>
    <% }) %>
  </div>
  <% } else { %>
  <div class="text-center py-24">
    <div class="text-7xl mb-4"><i class="fa-solid fa-heart text-red-500"></i></div>
    <h2 class="text-xl font-bold dark:text-white mb-2">Your wishlist is empty</h2>
    <p class="text-gray-500 dark:text-gray-400 mb-6">Save items you love by clicking the heart icon.</p>
    <a href="/shop" class="btn-primary inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold">Explore Products <i class="fa-solid fa-arrow-right"></i></a>
  </div>
  <% } %>
</div>