<% layout('layouts/user') %>
<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-5 md:py-8">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-3xl font-black dark:text-white">My <span class="text-accent-500">Addresses</span></h1>
    <button onclick="document.getElementById('addAddressModal').classList.remove('hidden')"
      class="btn-primary px-4 py-2.5 rounded-xl font-bold text-sm flex items-center gap-2">
      <i class="fa-solid fa-plus text-xs"></i> Add Address
    </button>
  </div>

  <% if (addresses && addresses.length) { %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <% addresses.forEach(addr => { %>
    <div class="bg-white dark:bg-gray-900 rounded-2xl border <%= addr.isDefault ? 'border-accent-400 ring-2 ring-accent-500/20' : 'border-gray-200 dark:border-gray-800' %> p-5 relative">
      <% if (addr.isDefault) { %>
      <span class="absolute top-3 right-3 badge bg-accent-100 dark:bg-accent-900/30 text-accent-600 dark:text-accent-400 text-xs">Default</span>
      <% } %>
      <div class="flex items-center gap-2 mb-2">
        <i class="fa-solid fa-<%= addr.addressType === 'home' ? 'house' : addr.addressType === 'office' ? 'building' : 'map-marker-alt' %> text-accent-500 text-sm"></i>
        <span class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider capitalize"><%= addr.addressType %></span>
      </div>
      <p class="font-bold dark:text-white mb-1"><%= addr.fullName %></p>
      <p class="text-sm text-gray-600 dark:text-gray-400"><%= addr.addressLine1 %><% if(addr.addressLine2){%>, <%= addr.addressLine2 %><% } %></p>
      <p class="text-sm text-gray-600 dark:text-gray-400"><%= addr.city %>, <%= addr.state %> — <%= addr.pincode %></p>
      <p class="text-sm text-gray-600 dark:text-gray-400"><%= addr.country %></p>
      <p class="text-sm text-gray-500 dark:text-gray-500 mt-1">📞 <%= addr.phone %></p>
      <div class="flex gap-2 mt-4 pt-4 border-t border-gray-100 dark:border-gray-800">
        <button onclick="editAddress(<%- JSON.stringify(addr) %>)" class="flex-1 text-xs border border-gray-200 dark:border-gray-700 rounded-lg py-2 text-gray-600 dark:text-gray-400 hover:border-accent-400 hover:text-accent-500 transition-all">Edit</button>
        <button onclick="deleteAddress('<%= addr._id %>')" class="px-3 py-2 text-xs border border-red-200 dark:border-red-900/50 rounded-lg text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition-all"><i class="fa-solid fa-trash-can"></i></button>
      </div>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <div class="text-center py-24">
    <div class="text-7xl mb-4">🏠</div>
    <h2 class="text-xl font-bold dark:text-white mb-2">No addresses saved</h2>
    <p class="text-gray-500 dark:text-gray-400 mb-6">Add your first shipping address</p>
  </div>
  <% } %>
</div>

<!-- Add Address Modal -->
<div id="addAddressModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 transparent-black" onclick="this.parentElement.classList.add('hidden')"></div>
  <div class="relative bg-white dark:bg-gray-900 rounded-2xl shadow-2xl w-full max-w-md border border-gray-200 dark:border-gray-800 overflow-y-auto max-h-[90vh]">
    <div class="p-6 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between">
      <h3 class="font-bold dark:text-white">Add New Address</h3>
      <button onclick="document.getElementById('addAddressModal').classList.add('hidden')" class="text-gray-400"><i class="fa-solid fa-xmark text-xl"></i></button>
    </div>
    <form action="/profile/addresses/add" method="POST" class="p-6 space-y-3">
      <div class="grid grid-cols-2 gap-3">
        <div class="col-span-2"><label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider block mb-1">Full Name *</label><input type="text" name="fullName" required placeholder="John Doe" class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/></div>
        <div class="col-span-2 md:col-span-1"><label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider block mb-1">Phone *</label><input type="tel" name="phone" required placeholder="+91 9876543210" class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/></div>
        <div class="col-span-2 md:col-span-1"><label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider block mb-1">Type</label>
          <select name="addressType" class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none">
            <option value="home">Home</option><option value="office">Office</option><option value="other">Other</option>
          </select>
        </div>
        <div class="col-span-2"><label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider block mb-1">Address Line 1 *</label><input type="text" name="addressLine1" required placeholder="House/Flat no., Street" class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/></div>
        <div class="col-span-2"><label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider block mb-1">Address Line 2</label><input type="text" name="addressLine2" placeholder="Landmark (optional)" class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/></div>
        <div><label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider block mb-1">City *</label><input type="text" name="city" required class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/></div>
        <div><label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider block mb-1">State *</label>
          <select name="state" required class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none">
            <%- include('../partials/shared/state-options') %>
          </select>
        </div>
        <div><label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider block mb-1">Pincode *</label><input type="text" name="pincode" required class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/></div>
        <div class="flex items-center gap-2 pt-1 col-span-2"><input type="checkbox" name="isDefault" value="true" id="defaultCheck" class="w-4 h-4 accent-yellow-500"/><label for="defaultCheck" class="text-sm text-gray-600 dark:text-gray-400 cursor-pointer">Set as default address</label></div>
      </div>
      <button type="submit" class="w-full btn-primary py-3 rounded-xl font-bold mt-4">Save Address</button>
    </form>
  </div>
</div>

<!-- Edit Address Modal -->
<div id="editAddressModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 transparent-black" onclick="this.parentElement.classList.add('hidden')"></div>
  <div class="relative bg-white dark:bg-gray-900 rounded-2xl shadow-2xl w-full max-w-md border border-gray-200 dark:border-gray-800 overflow-y-auto max-h-[90vh]">
    <div class="p-6 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between">
      <h3 class="font-bold dark:text-white">Edit Address</h3>
      <button onclick="document.getElementById('editAddressModal').classList.add('hidden')" class="text-gray-400"><i class="fa-solid fa-xmark text-xl"></i></button>
    </div>
    <form id="editAddressForm" method="POST" class="p-6 space-y-3">
      <input type="text" id="editFullName" name="fullName" required placeholder="Full Name" class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/>
      <input type="tel" id="editPhone" name="phone" required placeholder="Phone" class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/>
      <input type="text" id="editLine1" name="addressLine1" required placeholder="Address Line 1" class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/>
      <input type="text" id="editLine2" name="addressLine2" placeholder="Address Line 2" class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/>
      <div class="grid grid-cols-2 gap-3">
        <input type="text" id="editCity" name="city" required placeholder="City" class="border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/>
        <select id="editState" name="state" required class="border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none">
          <%- include('../partials/shared/state-options') %>
        </select>
        <input type="text" id="editPincode" name="pincode" required placeholder="Pincode" class="border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/>
        <select id="editType" name="addressType" class="border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none">
          <option value="home">Home</option><option value="office">Office</option><option value="other">Other</option>
        </select>
      </div>
      <label class="flex items-center gap-2"><input type="checkbox" id="editDefault" name="isDefault" value="true" class="w-4 h-4 accent-yellow-500"/><span class="text-sm text-gray-600 dark:text-gray-400">Set as default</span></label>
      <button type="submit" class="w-full btn-primary py-3 rounded-xl font-bold">Save Changes</button>
    </form>
  </div>
</div>

<script>
function editAddress(addr) {
  document.getElementById('editFullName').value = addr.fullName;
  document.getElementById('editPhone').value = addr.phone;
  document.getElementById('editLine1').value = addr.addressLine1;
  document.getElementById('editLine2').value = addr.addressLine2 || '';
  document.getElementById('editCity').value = addr.city;
  document.getElementById('editState').value = addr.state;
  document.getElementById('editPincode').value = addr.pincode;
  document.getElementById('editType').value = addr.addressType;
  document.getElementById('editDefault').checked = addr.isDefault;
  document.getElementById('editAddressForm').action = `/profile/addresses/${addr._id}/update`;
  document.getElementById('editAddressModal').classList.remove('hidden');
}

async function deleteAddress(id) {
  if (!confirm('Delete this address?')) return;
  const r = await fetch(`/profile/addresses/${id}`, { method: 'DELETE' });
  const d = await r.json();
  if (d.success) { showToast('Address deleted', 'info'); window.location.reload(); }
}
</script>
