<% layout('layouts/common') %>
<div class="max-w-2xl mx-auto px-4 py-8 sm:py-16 text-center">
  <div class="bg-white dark:bg-gray-900 rounded-3xl border border-gray-200 dark:border-gray-800 p-6 sm:p-10 shadow-xl">
    <div class="w-20 h-20 sm:w-24 sm:h-24 bg-green-100 dark:bg-green-900/20 rounded-full flex items-center justify-center mx-auto mb-6 animate-bounce-in">
      <i class="fa-solid fa-circle-check text-green-500 text-4xl sm:text-5xl"></i>
    </div>
    <h1 class="text-2xl sm:text-3xl font-bold dark:text-white mb-2">Order Placed! 🎉</h1>
    <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400 mb-6">Thank you for your order. We'll send you a confirmation email shortly.</p>

    <div class="bg-gray-50 dark:bg-gray-800 rounded-2xl p-4 sm:p-5 mb-6 text-left space-y-3">
      <div class="flex justify-between items-center text-xs sm:text-sm">
        <span class="text-gray-500 dark:text-gray-400 mr-2">Order Number</span>
        <span class="font-bold dark:text-white break-all text-right">#<%= order.orderNumber %></span>
      </div>
      <div class="flex justify-between text-xs sm:text-sm">
        <span class="text-gray-500 dark:text-gray-400">Payment</span>
        <span class="font-semibold capitalize dark:text-white"><%= order.paymentMethod %></span>
      </div>
      <div class="flex justify-between text-xs sm:text-sm">
        <span class="text-gray-500 dark:text-gray-400">Total Amount</span>
        <span class="font-bold text-accent-500">₹<%= order.totalAmount.toLocaleString('en-IN') %></span>
      </div>
      <div class="flex justify-between text-xs sm:text-sm">
        <span class="text-gray-500 dark:text-gray-400">Estimated Delivery</span>
        <% const isKerala = (order.shippingAddress?.state || '').trim().toLowerCase() === 'kerala'; %>
        <span class="font-semibold dark:text-white"><%= isKerala ? '2-3 Business Days' : '4-15 Business Days' %></span>
      </div>
    </div>

    <div class="space-y-2 mb-6">
      <% order.items.slice(0,3).forEach(item => { %>
      <div class="flex items-center gap-3 text-left bg-gray-50 dark:bg-gray-800 rounded-xl p-3">
        <img src="<%= item.productImage || '/images/placeholder.png' %>" class="w-12 h-12 rounded-lg object-cover"/>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium dark:text-white truncate"><%= item.productName %></p>
          <p class="text-xs text-gray-400">Qty: <%= item.quantity %> × ₹<%= item.price.toLocaleString('en-IN') %></p>
        </div>
      </div>
      <% }) %>
    </div>

    <div class="flex flex-col sm:flex-row gap-3">
      <a href="/orders/<%= order._id %>" class="w-full sm:flex-1 btn-primary py-3 rounded-xl font-semibold flex items-center justify-center gap-2"><i class="fa-solid fa-box"></i>Track Order</a>
      <a href="/shop" class="w-full sm:flex-1 py-3 border-2 border-gray-200 dark:border-gray-700 rounded-xl font-semibold dark:text-gray-300 hover:border-accent-500 hover:text-accent-500 transition-all flex items-center justify-center gap-2">Continue Shopping</a>
    </div>
  </div>
</div>