<% layout('layouts/user') %>
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-5 md:py-8">
  <h1 class="text-3xl font-black dark:text-white mb-8">My <span class="text-accent-500">Profile</span></h1>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Avatar Card -->
    <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 p-6 text-center">
      <form action="/profile/update" method="POST" enctype="multipart/form-data" id="avatarForm">
        <div class="relative w-24 h-24 mx-auto mb-4">
          <% if (currentUser.avatar) { %>
          <img src="<%= currentUser.avatar %>" alt="Avatar" class="w-24 h-24 rounded-full object-cover border-4 border-accent-500"/>
          <% } else { %>
          <div class="w-24 h-24 rounded-full bg-gradient-to-br from-accent-400 to-accent-600 flex items-center justify-center text-white font-black text-3xl border-4 border-accent-500"><%= currentUser.name.charAt(0).toUpperCase() %></div>
          <% } %>
          <label class="absolute bottom-0 right-0 w-8 h-8 bg-accent-500 rounded-full flex items-center justify-center cursor-pointer shadow-lg hover:bg-accent-600 transition-colors">
            <i class="fa-solid fa-camera text-white text-xs"></i>
            <input type="file" name="avatar" accept="image/*" class="hidden" onchange="document.getElementById('avatarForm').submit()"/>
          </label>
        </div>
        <h2 class="font-bold text-xl dark:text-white"><%= currentUser.name %></h2>
        <p class="text-gray-500 dark:text-gray-400 text-sm"><%= currentUser.email %></p>
        <% if (currentUser.isEmailVerified) { %><span class="inline-flex items-center gap-1 text-xs text-green-500 bg-green-50 dark:bg-green-900/20 px-2 py-0.5 rounded-full mt-2 font-semibold"><i class="fa-solid fa-circle-check text-xs"></i>Verified</span><% } %>
      </form>

      <div class="mt-5 space-y-2 text-sm">
        <div class="flex items-center justify-between bg-gray-50 dark:bg-gray-800 rounded-xl p-3">
          <span class="text-gray-500">Wallet</span>
          <span class="font-bold text-green-500">₹<%= currentUser.walletBalance || 0 %></span>
        </div>
        <div class="flex items-center justify-between bg-gray-50 dark:bg-gray-800 rounded-xl p-3">
          <span class="text-gray-500">Referral Code</span>
          <span class="font-mono font-bold dark:text-white text-xs"><%= currentUser.referralCode %></span>
        </div>
      </div>
    </div>

    <!-- Edit Profile Form -->
    <div class="md:col-span-2 space-y-5">
      <form action="/profile/update" method="POST" class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 p-6">
        <h3 class="font-bold dark:text-white mb-4">Personal Information</h3>
        <div class="grid grid-cols-2 gap-4">
          <div class="col-span-2">
            <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider block mb-1.5">Full Name</label>
            <input type="text" name="name" value="<%= currentUser.name %>" required class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/>
          </div>
          <div class="col-span-2 md:col-span-1">
            <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider block mb-1.5">Phone</label>
            <input type="tel" name="phone" value="<%= currentUser.phone || '' %>" class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/>
          </div>
          <div class="col-span-2 md:col-span-1">
            <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider block mb-1.5">Gender</label>
            <select name="gender" class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none">
              <option value="">Prefer not to say</option>
              <% ['male','female','other'].forEach(g => { %><option value="<%= g %>" <%= currentUser.gender === g ? 'selected' : '' %> class="capitalize"><%= g %></option><% }) %>
            </select>
          </div>
          <div class="col-span-2 md:col-span-1">
            <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider block mb-1.5">Date of Birth</label>
            <input type="date" name="dateOfBirth" value="<%= currentUser.dateOfBirth ? new Date(currentUser.dateOfBirth).toISOString().split('T')[0] : '' %>" class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/>
          </div>
        </div>
        <button type="submit" class="btn-primary px-6 py-2.5 rounded-xl font-semibold text-sm mt-4">Save Changes</button>
      </form>

      <!-- Change Password -->
      <form action="/profile/change-password" method="POST" class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 p-6">
        <h3 class="font-bold dark:text-white mb-4">Change Password</h3>
        <div class="space-y-3">
          <div><label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider block mb-1.5">Current Password</label>
          <input type="password" name="currentPassword" required class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/></div>
          <div><label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider block mb-1.5">New Password</label>
          <input type="password" name="newPassword" required minlength="8" class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/></div>
          <div><label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider block mb-1.5">Confirm New Password</label>
          <input type="password" name="confirmPassword" required minlength="8" class="w-full border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/></div>
        </div>
        <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-6 py-2.5 rounded-xl font-semibold text-sm mt-4 transition-colors">Change Password</button>
      </form>

      <!-- 2FA Setup -->
      <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 p-6">
        <div class="flex items-center justify-between mb-3">
          <div>
            <h3 class="font-bold dark:text-white">Two-Factor Authentication</h3>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Add extra security to your account</p>
          </div>
          <span class="badge <%= currentUser.twoFactorEnabled ? 'bg-green-100 dark:bg-green-900/20 text-green-600 dark:text-green-400' : 'bg-gray-100 dark:bg-gray-800 text-gray-500' %>"><%= currentUser.twoFactorEnabled ? 'Enabled' : 'Disabled' %></span>
        </div>
        <% if (!currentUser.twoFactorEnabled) { %>
        <button onclick="setup2FA()" class="btn-primary px-4 py-2 rounded-lg text-sm font-semibold">Enable 2FA</button>
        <div id="qrSection" class="hidden mt-4">
          <img id="qrImage" class="w-40 h-40 mx-auto rounded-xl"/>
          <div class="flex gap-2 mt-3">
            <input type="text" id="twoFACode" placeholder="Enter 6-digit code" maxlength="6" class="flex-1 border border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-2 text-sm focus:ring-2 focus:ring-accent-500 outline-none"/>
            <button onclick="enable2FA()" class="btn-primary px-4 py-2 rounded-xl text-sm font-semibold">Verify</button>
          </div>
        </div>
        <% } else { %>
        <button onclick="disable2FA()" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg text-sm font-semibold transition-colors">Disable 2FA</button>
        <% } %>
      </div>
    </div>
  </div>
</div>
<script>
async function setup2FA() {
  const r = await fetch('/profile/2fa/setup', { method:'POST' });
  const d = await r.json();
  if (d.success) {
    document.getElementById('qrImage').src = d.qrCode;
    document.getElementById('qrSection').classList.remove('hidden');
  }
}
async function enable2FA() {
  const token = document.getElementById('twoFACode').value;
  const r = await fetch('/profile/2fa/enable', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ token }) });
  const d = await r.json();
  if (d.success) { showToast('2FA enabled!', 'success'); setTimeout(() => window.location.reload(), 1000); }
  else showToast(d.message || 'Invalid code', 'error');
}
async function disable2FA() {
  const token = prompt('Enter your 2FA code to disable:');
  if (!token) return;
  const r = await fetch('/profile/2fa/disable', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ token }) });
  const d = await r.json();
  if (d.success) { showToast('2FA disabled', 'info'); setTimeout(() => window.location.reload(), 1000); }
  else showToast(d.message || 'Invalid code', 'error');
}
</script>
