<% layout('layouts/common') %>
<!-- Back to Home Floating Button -->
<div class="fixed top-6 left-6 z-50">
  <a href="/" class="flex items-center justify-center w-10 h-10 rounded-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-md text-gray-600 dark:text-gray-300 hover:text-accent-500 dark:hover:text-accent-400 hover:border-accent-500 transition-all group" title="Back to Home">
    <i class="fa-solid fa-arrow-left text-sm group-hover:-translate-x-0.5 transition-transform"></i>
  </a>
</div>

<div class="min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md animate-slide-in-up">
    <div class="bg-white dark:bg-gray-900 rounded-3xl shadow-2xl overflow-hidden">
      <div class="pt-8 text-center">
        <div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-3 shadow-xl overflow-hidden">
          <img
            src="/images/logo.svg"
            alt="AD21Store Logo"
            class="w-full h-full object-contain"
          />
        </div>
        <h1 class="text-2xl font-black">Create Account</h1>
        <p class="text-gray-400 text-sm mt-1">Join thousands of football enthusiasts</p>
      </div>
      <div class="p-5 sm:p-8">
        <a href="/auth/google" class="w-full flex items-center justify-center gap-3 border-2 border-gray-200 dark:border-gray-700 rounded-xl py-3 font-semibold text-gray-700 dark:text-gray-300 hover:border-accent-400 transition-all mb-5">
          <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" class="w-5 h-5"/> Continue with Google
        </a>
        <div class="relative mb-5"><div class="absolute inset-0 flex items-center"><div class="w-full border-t border-gray-200 dark:border-gray-700"></div></div><div class="relative flex justify-center text-xs uppercase"><span class="bg-white dark:bg-gray-900 px-3 text-gray-400 font-semibold">or</span></div></div>
        <form action="/auth/register" method="POST" class="space-y-4">
          <% if (referralCode) { %><input type="hidden" name="referralCode" value="<%= referralCode %>"/><% } %>
          <div>
            <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1.5 block">Full Name</label>
            <div class="relative"><i class="fa-solid fa-user absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
            <input type="text" name="name" required placeholder="John Doe" class="w-full border-2 border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl pl-11 pr-4 py-3 text-sm focus:border-accent-500 outline-none transition-all"/></div>
          </div>
          <div>
            <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1.5 block">Email</label>
            <div class="relative"><i class="fa-solid fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
            <input type="email" name="email" required placeholder="you@example.com" class="w-full border-2 border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl pl-11 pr-4 py-3 text-sm focus:border-accent-500 outline-none transition-all"/></div>
          </div>
          <div>
            <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1.5 block">Phone (optional)</label>
            <div class="relative"><i class="fa-solid fa-phone absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
            <input type="tel" name="phone" placeholder="+91 9876543210" class="w-full border-2 border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl pl-11 pr-4 py-3 text-sm focus:border-accent-500 outline-none transition-all"/></div>
          </div>
          <div>
            <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1.5 block">Password</label>
            <div class="relative"><i class="fa-solid fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
            <input type="password" name="password" id="pwd" required placeholder="Min 8 characters" minlength="8" class="w-full border-2 border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl pl-11 pr-12 py-3 text-sm focus:border-accent-500 outline-none transition-all"/>
            <button type="button" onclick="togglePassword('pwd', this)" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400"><i class="fa-regular fa-eye text-sm"></i></button></div>
          </div>
          <% if (referralCode) { %>
          <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-xl p-3 flex items-center gap-2">
            <i class="fa-solid fa-gift text-green-500"></i>
            <span class="text-sm text-green-700 dark:text-green-400">Referral code applied: <strong><%= referralCode %></strong></span>
          </div>
          <% } %>
          <button type="submit" class="w-full btn-primary py-3.5 rounded-xl font-bold text-base">Create Account</button>
        </form>
        <p class="text-center text-sm text-gray-500 dark:text-gray-400 mt-5">Already have an account? <a href="/auth/login" class="text-accent-500 font-semibold">Sign in →</a></p>
      </div>
    </div>
  </div>
</div>
<script>function togglePassword(id, btn) { const i = document.getElementById(id); const t = i.type === 'text'; i.type = t ? 'password' : 'text'; btn.querySelector('i').className = `fa-regular fa-eye${t ? '' : '-slash'} text-sm`; }</script>