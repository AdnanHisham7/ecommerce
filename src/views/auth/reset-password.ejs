<% layout('layouts/common') %>
<div class="min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md animate-slide-in-up">
    <div class="bg-white dark:bg-gray-900 rounded-3xl shadow-2xl overflow-hidden">
      <div class="pt-8 text-center">
        <div class="w-16 h-16 bg-accent-500 rounded-2xl flex items-center justify-center mx-auto mb-3 shadow-xl"><i class="fa-solid fa-lock text-white text-2xl"></i></div>
        <h1 class="text-2xl font-black dark:text-white">Reset Password</h1>
        <p class="text-gray-400 text-sm mt-1">Choose a strong new password</p>
      </div>
      <div class="p-5 sm:p-8">
        <form action="/auth/reset-password/<%= token %>" method="POST" class="space-y-4">
          <div>
            <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1.5 block">New Password</label>
            <div class="relative"><i class="fa-solid fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
            <input type="password" name="password" id="pwd" required minlength="8" placeholder="Min 8 characters" class="w-full border-2 border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl pl-11 pr-12 py-3 text-sm focus:border-accent-500 outline-none transition-all"/>
            <button type="button" onclick="togglePwd('pwd',this)" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400"><i class="fa-regular fa-eye text-sm"></i></button></div>
          </div>
          <div>
            <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1.5 block">Confirm Password</label>
            <div class="relative"><i class="fa-solid fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
            <input type="password" name="confirmPassword" id="cpwd" required minlength="8" placeholder="Confirm new password" class="w-full border-2 border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl pl-11 pr-12 py-3 text-sm focus:border-accent-500 outline-none transition-all"/>
            <button type="button" onclick="togglePwd('cpwd',this)" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400"><i class="fa-regular fa-eye text-sm"></i></button></div>
          </div>
          <button type="submit" class="w-full btn-primary py-3.5 rounded-xl font-bold text-base">Reset Password</button>
        </form>
      </div>
    </div>
  </div>
</div>
<script>function togglePwd(id, btn) { const i = document.getElementById(id); const t = i.type==='text'; i.type=t?'password':'text'; btn.querySelector('i').className=`fa-regular fa-eye${t?'':'-slash'} text-sm`; }</script>
