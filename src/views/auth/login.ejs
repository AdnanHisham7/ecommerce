<% layout('layouts/common') %>
<!-- Back to Home Floating Button -->
<div class="fixed top-6 left-6 z-50">
  <a href="/" class="flex items-center justify-center w-10 h-10 rounded-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-md text-gray-600 dark:text-gray-300 hover:text-accent-500 dark:hover:text-accent-400 hover:border-accent-500 transition-all group" title="Back to Home">
    <i class="fa-solid fa-arrow-left text-sm group-hover:-translate-x-0.5 transition-transform"></i>
  </a>
</div>

<div class="min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md animate-slide-in-up">
    <div class="bg-white dark:bg-gray-900 rounded-3xl shadow-2xl overflow-hidden">
      <!-- Header -->
      <div class="pt-8 text-center">
        <div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-3 shadow-2xl overflow-hidden">
          <img
            src="/images/logo.svg"
            alt="AD21Store Logo"
            class="w-full h-full object-contain"
          />
        </div>
        <h1 class="text-2xl font-black">Welcome Back!</h1>
        <p class="text-gray-400 text-sm mt-1">Sign in to your <%= brand.name %> account</p>
      </div>

      <div class="p-5 sm:p-8">
        <!-- Google Login -->
        <a href="/auth/google" class="w-full flex items-center justify-center gap-3 border-2 border-gray-200 dark:border-gray-700 rounded-xl py-3 font-semibold text-gray-700 dark:text-gray-300 hover:border-accent-400 hover:bg-accent-50 dark:hover:bg-gray-800 transition-all mb-5">
          <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" class="w-5 h-5"/> Continue with Google
        </a>

        <div class="relative mb-5"><div class="absolute inset-0 flex items-center"><div class="w-full border-t border-gray-200 dark:border-gray-700"></div></div><div class="relative flex justify-center text-xs uppercase"><span class="bg-white dark:bg-gray-900 px-3 text-gray-400 font-semibold">or</span></div></div>

        <form action="/auth/login" method="POST" class="space-y-4">
          <input type="hidden" name="returnTo" value="<%= returnTo || '/' %>"/>
          <div>
            <label class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1.5">Email Address</label>
            <div class="relative">
              <i class="fa-solid fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
              <input type="email" name="email" required placeholder="you@example.com"
                class="w-full border-2 border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl pl-11 pr-4 py-3 text-sm focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20 outline-none transition-all"/>
            </div>
          </div>
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Password</label>
              <a href="/auth/forgot-password" class="text-xs text-accent-500 hover:text-accent-600 font-semibold">Forgot password?</a>
            </div>
            <div class="relative">
              <i class="fa-solid fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
              <input type="password" name="password" id="passwordInput" required placeholder="••••••••"
                class="w-full border-2 border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl pl-11 pr-12 py-3 text-sm focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20 outline-none transition-all"/>
              <button type="button" onclick="togglePassword('passwordInput', this)" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition-colors">
                <i class="fa-regular fa-eye text-sm"></i>
              </button>
            </div>
          </div>
          <button type="submit" class="w-full btn-primary py-3.5 rounded-xl font-bold text-base">Sign In</button>
        </form>

        <p class="text-center text-sm text-gray-500 dark:text-gray-400 mt-5">
          Don't have an account? <a href="/auth/register" class="text-accent-500 font-semibold hover:text-accent-600">Register →</a>
        </p>
      </div>
    </div>
  </div>
</div>
<script>
function togglePassword(id, btn) {
  const input = document.getElementById(id);
  const isText = input.type === 'text';
  input.type = isText ? 'password' : 'text';
  btn.querySelector('i').className = `fa-regular fa-eye${isText ? '' : '-slash'} text-sm`;
}
</script>