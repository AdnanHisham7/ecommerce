<% layout('layouts/common') %>
<div class="min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md animate-slide-in-up">
    <div class="bg-white dark:bg-gray-900 rounded-3xl shadow-2xl overflow-hidden">
      <div class="pt-8 text-center">
        <div class="w-16 h-16 bg-accent-500 rounded-2xl flex items-center justify-center mx-auto mb-3 shadow-xl">
          <i class="fa-solid fa-shield-halved text-white text-2xl"></i>
        </div>
        <h1 class="text-2xl font-black text-white">Two-Factor Auth</h1>
        <p class="text-gray-400 text-sm mt-1">Enter the 6-digit code from your authenticator app</p>
      </div>
      <div class="p-5 sm:p-8">
        <form action="/auth/2fa" method="POST" class="space-y-4">
          <div>
            <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider block mb-2">Authentication Code</label>
            <input type="text" name="token" required maxlength="6" minlength="6" pattern="[0-9]{6}"
              placeholder="000000" inputmode="numeric" autofocus
              class="w-full text-center text-3xl font-black tracking-[0.5em] border-2 border-gray-200 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 rounded-xl px-4 py-4 focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20 outline-none transition-all"/>
          </div>
          <button type="submit" class="w-full btn-primary py-3.5 rounded-xl font-bold text-base">Verify</button>
        </form>
        <div class="text-center mt-4">
          <a href="/auth/logout" class="text-gray-500 dark:text-gray-400 hover:text-red-500 text-sm transition-colors">Cancel & Logout</a>
        </div>
      </div>
    </div>
  </div>
</div>
